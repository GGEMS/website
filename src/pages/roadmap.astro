<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Follow the GGEMS development roadmap toward the first public release."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <link rel="icon" type="image/png" href="/images/ggems-logo.png" />
    <link rel="apple-touch-icon" href="/images/ggems-logo.png" />

    <title>Roadmap — GGEMS</title>

    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('ggems-theme');
        const theme =
          storedTheme ??
          (window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark');

        document.documentElement.dataset.theme = theme;

        const storedLang = localStorage.getItem('ggems-language');
        const supportedLanguages = ['en', 'fr', 'de', 'it', 'es', 'pt-BR'];
        const lang =
          storedLang && supportedLanguages.includes(storedLang)
            ? storedLang
            : 'en';

        document.documentElement.lang = lang;
        document.documentElement.dataset.lang = lang;
      })();
    </script>
  </head>

  <body>
