    <script is:inline define:vars={{ supportedLanguages: languages, pageDescriptions }}>
      (() => {
        const root = document.documentElement;
        const themeButton = document.querySelector('.theme-toggle');
        const languageButtons = document.querySelectorAll('[data-language]');
        const description = document.querySelector('meta[name="description"]');

        const setLanguage = (lang) => {
          root.dataset.lang = lang;
          root.lang = lang;
          localStorage.setItem('ggems-language', lang);

          languageButtons.forEach((button) => {
            button.classList.toggle('active', button.dataset.language === lang);
          });

          document.querySelector('.language-switcher')?.removeAttribute('open');

          description?.setAttribute('content', pageDescriptions[lang] ?? pageDescriptions.en);
        };

        languageButtons.forEach((button) => {
          button.addEventListener('click', () => setLanguage(button.dataset.language));
        });

        themeButton?.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = nextTheme;
          localStorage.setItem('ggems-theme', nextTheme);
        });

        setLanguage(
          supportedLanguages.includes(root.dataset.lang)
            ? root.dataset.lang
            : 'en'
        );
      })();
    </script>
