---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

const sections = [
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Core rebuild',
    description:
      'A modern GPU-first software foundation for the new GGEMS implementation.',
    groups: [
      {
        title: 'Core',
        items: [
          'Modern C++ architecture',
          'Project structure',
          'OpenCL foundation',
          'GPU-first execution model',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Source system',
    description:
      'A dedicated source subsystem for controlled and reproducible particle generation.',
    groups: [
      {
        title: 'Sampling',
        items: [
          'General source sampling',
          'Geometry / angle / energy / time',
          'Random / reproducibility foundations',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Radionuclides',
    description:
      'Activity-driven source workflows and a medical radionuclide foundation.',
    groups: [
      {
        title: 'Radionuclide sources',
        items: [
          'Activity-driven sources',
          'Medical radionuclide catalog',
          'LNHB / MIRDsoft data foundations',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Testing & validation framework',
    description:
      'A reproducible validation workflow accompanies implementation from the beginning.',
    groups: [
      {
        title: 'Validation infrastructure',
        items: [
          'C++ unit tests',
          'Python validation tools',
          'Campaign automation',
          'Reference datasets',
          'Statistical validation foundations',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Materials & Cuts',
    description:
      'Material definition and production-cut foundations for the first physical transport chain.',
    groups: [
      {
        title: 'Materials',
        items: [
          'Isotopic materials',
          'Material identity / compilation',
        ],
      },
      {
        title: 'Production Cuts',
        items: [
          'Production Cuts',
          'Material / Cut couples',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Software / UI / doc cleanup',
    description:
      'The software surface and developer-facing tools were consolidated before physical implementation continues.',
    groups: [
      {
        title: 'Software & UI',
        items: [
          'Renderer / Vulkan / ImGui restructuring',
          'Public API cleanup',
        ],
      },
      {
        title: 'Documentation',
        items: [
          'Doxygen cleanup',
          'Website / documentation foundations',
        ],
      },
    ],
  },
  {
    status: 'current',
    eyebrow: 'In progress',
    title: 'Navigation',
    description:
      'Current implementation work focuses on the first bounded geometry slice.',
    groups: [
      {
        title: 'Geometry scope',
        items: [
          'Finite World',
          'Analytic Box',
          'Initial bounded navigation',
        ],
      },
      {
        title: 'Later extensions',
        items: [
          'Voxels',
          'Mesh-based geometries',
          'More complex navigation cases',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Physical Processes',
    description:
      'Physics is implemented and validated by particle family, starting from the first medically relevant transport chains.',
    groups: [
      {
        title: 'Gamma',
        items: [
          'Compton scattering',
          'Rayleigh scattering',
          'Photoelectric effect',
          'Pair production',
          'Atomic relaxation',
        ],
      },
      {
        title: 'Electron / Positron',
        items: [
          'Ionization',
          'Bremsstrahlung',
          'Annihilation',
          'Multiple scattering',
          'Stopping / range',
        ],
      },
      {
        title: 'Proton / Alpha',
        items: [
          'Stopping',
          'Ionization',
          'Multiple scattering',
          'NIEL',
        ],
      },
      {
        title: 'Neutron',
        items: [
          'Evaluated nuclear data',
          'Elastic / inelastic / capture',
          'Thermal treatment / HP-HPT',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Transport',
    description:
      'Transport connects geometry and physical processes into complete particle histories.',
    groups: [
      {
        title: 'First transport chain',
        items: [
          'Process / geometry competition',
          'Physical step',
          'Secondary production',
          'Time of flight',
          'Field-free transport',
        ],
      },
      {
        title: 'Later transport scope',
        items: [
          'Charged-particle transport extensions',
          'Multiple-scattering integration',
          'Magnetic-field support',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Scoring',
    description:
      'Accepted particle transport becomes measurable scientific output.',
    groups: [
      {
        title: 'Scientific quantities',
        items: [
          'Energy deposition',
          'Dose',
          'Photon TLE',
          'History statistics',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Detector & Acquisition',
    description:
      'The detector chain transforms physical interactions into acquisition-level data products.',
    groups: [
      {
        title: 'Sensitive detector',
        items: [
          'Detector elements',
          'Raw Hits',
        ],
      },
      {
        title: 'Digitizer',
        items: [
          'Detector response',
          'Energy and timing response',
          'Efficiency and thresholds',
          'Energy windows',
          'Dead time',
        ],
      },
      {
        title: 'Acquisition',
        items: [
          'Scanner states',
          'Motion',
          'Exposures and projections',
          'Temporal acquisition logic',
        ],
      },
      {
        title: 'Detector data',
        items: [
          'Singles',
          'Coincidences',
          'PET / SPECT products',
          'CT / CBCT products',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Scientific I/O & Reconstruction',
    description:
      'Committed GGEMS scientific products are exposed through explicit data formats and reconstruction-oriented interoperability.',
    groups: [
      {
        title: 'Scientific I/O',
        items: [
          'MHD',
          '...',
        ],
      },
      {
        title: 'Reconstruction ecosystem',
        items: [
          'STIR',
          'CASToR',
          '...',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Integration, Validation & Performance',
    description:
      'Complete workflows are qualified only after their scientific components and cross-domain behavior are established.',
    groups: [
      {
        title: 'Integration',
        items: [
          'Named modalities',
          'Multi-device',
          'Reproducibility',
        ],
      },
      {
        title: 'Qualification',
        items: [
          'Scientific validation',
          'Performance characterization',
          'Optimization without changing the science',
        ],
      },
    ],
  },
]
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Follow the GGEMS development roadmap toward the first public release."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <link rel="icon" type="image/png" href="/images/ggems-logo.png" />
    <link rel="apple-touch-icon" href="/images/ggems-logo.png" />

    <title>Roadmap — GGEMS</title>

    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('ggems-theme');
        const theme =
          storedTheme ??
          (window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark');

        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="GGEMS home">
          <img src="/images/ggems-logo.png" alt="" />
          <span class="brand-copy">
            <strong>GGEMS</strong>
            <small>GPU Geant4-based Monte Carlo Simulations</small>
          </span>
        </a>

        <button
          class="theme-toggle"
          type="button"
          aria-label="Switch color theme"
          title="Switch color theme"
        >
          <span class="theme-icon theme-dark" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation">
              <circle cx="12" cy="12" r="3.5"></circle>
              <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.28 5.28l1.42 1.42M17.3 17.3l1.42 1.42M18.72 5.28 17.3 6.7M6.7 17.3l-1.42 1.42"></path>
            </svg>
          </span>

          <span class="theme-icon theme-light" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation">
              <path d="M20 15.3A8.4 8.4 0 0 1 8.7 4a8.4 8.4 0 1 0 11.3 11.3Z"></path>
            </svg>
          </span>
        </button>
      </div>
    </header>

    <main class="roadmap-page">
    <section class="roadmap-hero">
      <div class="container hero-grid">
        <p class="eyebrow">Roadmap</p>

        <h1 class="heading-1">
          From validated foundations
          <span>to the GGEMS release.</span>
        </h1>

        <p class="lead">
          GGEMS is built incrementally: each domain is developed on top of
          validated foundations, integrated only when its upstream behavior is
          ready, and organized toward a public scientific release.
        </p>
      </div>
    </section>

    <section class="roadmap-flow">
      <div class="container flow-shell">
        <div class="roadmap-arrow" aria-hidden="true">
          <span class="arrow-line"></span>
          <span class="arrow-head"></span>
        </div>

        <div class="roadmap-sections">
          <article class="start-section">
            <div class="start-card">
              <h2>GGEMS 2.0 Begins</h2>
              <p>October 2025</p>
            </div>
          </article>

          {
            sections.map((section) => (
              <article class:list={['roadmap-section', `status-${section.status}`]}>
                <div class="section-content">
                  <header class="section-heading">
                    <div>
                      <p class="section-status">{section.eyebrow}</p>
                      <h2>{section.title}</h2>
                    </div>

                    <p>{section.description}</p>
                  </header>

                  {
                    section.groups.length > 0 && (
                      <div class:list={['group-grid', `groups-${Math.min(section.groups.length, 4)}`]}>
                        {
                          section.groups.map((group) => (
                            <section class="roadmap-group">
                              <h3>{group.title}</h3>

                              <ul>
                                {group.items.map((item) => <li>{item}</li>)}
                              </ul>
                            </section>
                          ))
                        }
                      </div>
                    )
                  }
                </div>
              </article>
            ))
          }

          <article class="release-section">
            <div class="release-card">
              <h2>GGEMS Release</h2>
              <p class="release-date">1st semester 2027</p>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <img src="/images/ggems-logo.png" alt="" />
          <strong>GGEMS</strong>
          <span>© {new Date().getFullYear()}</span>
        </div>

        <address>
          <strong>LaTIM — INSERM UMR 1101</strong>
          <span>22 Avenue Camille Desmoulins · 29238 Brest Cedex 3 · France</span>
        </address>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeButton = document.querySelector('.theme-toggle');

        themeButton?.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = nextTheme;
          localStorage.setItem('ggems-theme', nextTheme);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;

    --color-bg: #07111b;
    --color-bg-soft: #0a1520;
    --color-surface: #0b1723;
    --color-surface-raised: #101e2c;

    --color-text: #f5f8fb;
    --color-text-muted: #aab7c5;
    --color-text-subtle: #72808e;

    --color-green: #50c070;
    --color-green-light: #80d0a0;
    --color-green-dark: #309050;
    --color-purple: #8020e0;
    --color-yellow: #f0f000;

    --color-border: rgb(255 255 255 / 9%);
    --color-border-strong: rgb(255 255 255 / 16%);
    --color-control-bg: rgb(255 255 255 / 3%);
    --color-control-hover: rgb(255 255 255 / 6%);

    --font-sans: 'Space Grotesk', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;

    --content-width: 1180px;

    --radius-sm: 0.5rem;
    --radius-md: 0.75rem;
    --radius-lg: 1.25rem;

    --transition-fast: 160ms ease;
  }

  :root[data-theme='light'] {
    color-scheme: light;

    --color-bg: #f8faf9;
    --color-bg-soft: #edf2ef;
    --color-surface: #ffffff;
    --color-surface-raised: #f8faf9;

    --color-text: #16221c;
    --color-text-muted: #5e7067;
    --color-text-subtle: #829087;

    --color-border: rgb(22 34 28 / 10%);
    --color-border-strong: rgb(22 34 28 / 18%);
    --color-control-bg: rgb(22 34 28 / 3%);
    --color-control-hover: rgb(22 34 28 / 6%);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    color: var(--color-text);
    background: var(--color-bg);
    font-family: var(--font-sans);
    text-rendering: optimizeLegibility;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--color-text);
    background: var(--color-bg);
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  button {
    font: inherit;
  }

  .container {
    width: min(var(--content-width), calc(100% - 3rem));
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-green-light);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .heading-1 {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .lead {
    color: var(--color-text-muted);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.65;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;

    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    min-height: 5.1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand img {
    width: 2.45rem;
    height: 2.45rem;
    object-fit: contain;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
  }

  .brand-copy strong {
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .brand-copy small {
    color: var(--color-text-subtle);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .theme-toggle {
    width: 2.65rem;
    height: 2.65rem;
    display: grid;
    place-items: center;
    padding: 0;

    color: var(--color-text-muted);

    border: 1px solid var(--color-border);
    border-radius: 50%;

    background: rgb(127 127 127 / 4%);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    background: var(--color-control-hover);
  }

  .theme-icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  .theme-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :root[data-theme='dark'] .theme-light,
  :root[data-theme='light'] .theme-dark {
    display: none;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .footer-inner {
    min-height: 5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .footer-brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-brand img {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: contain;
  }

  .footer-brand strong {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .footer-brand span {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .site-footer address {
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.16rem;

    margin: 0;

    color: var(--color-text-subtle);
    font-style: normal;
    text-align: center;
  }

  .site-footer address strong {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
  }

  .site-footer address span {
    font-size: 0.74rem;
  }

  @media (max-width: 720px) {
    .container {
      width: min(var(--content-width), calc(100% - 2rem));
    }

    .brand-copy small {
      display: none;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.75rem;
      padding-block: 1rem;
    }

    .footer-brand,
    .site-footer address {
      justify-self: center;
    }
  }


  .roadmap-page {
    --roadmap-band-a: #07111b;
    --roadmap-band-b: #0d1b27;
    --roadmap-line: rgb(114 128 142 / 34%);
  }

  :root[data-theme='light'] .roadmap-page {
    --roadmap-band-a: #f8faf9;
    --roadmap-band-b: #dce7df;
    --roadmap-line: rgb(22 34 28 / 20%);
  }

  .roadmap-hero {
    padding-block: 5.5rem;
    background: var(--roadmap-band-a);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.25rem;
    align-items: start;
  }

  .hero-grid > .eyebrow {
    grid-area: eyebrow;
  }

  .hero-grid > .heading-1 {
    grid-area: title;
    margin: 0;
  }

  .hero-grid > .lead {
    grid-area: lead;
    margin: 0;
  }

  .hero-grid .heading-1 span {
    display: block;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .roadmap-flow {
    position: relative;
    background: var(--roadmap-band-b);
  }

  .flow-shell {
    position: relative;
    padding-block: 5rem 8rem;
  }

  .roadmap-arrow {
    position: absolute;
    top: 5rem;
    bottom: 5.5rem;
    left: 2.2rem;
    width: 1.6rem;
    pointer-events: none;
  }

  .arrow-line {
    position: absolute;
    top: 0;
    bottom: 1.1rem;
    left: 50%;
    width: 3px;
    background:
      linear-gradient(
        180deg,
        var(--color-green) 0%,
        var(--color-green) 43%,
        rgb(150 214 75) 47%,
        var(--color-yellow) 50%,
        rgb(171 176 68) 55%,
        var(--roadmap-line) 60%,
        var(--roadmap-line) 88%,
        rgb(96 58 154) 94%,
        var(--color-purple) 100%
      );
    transform: translateX(-50%);
  }

  .arrow-head {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 0;
    border-left: 0.55rem solid transparent;
    border-right: 0.55rem solid transparent;
    border-top: 0.95rem solid var(--color-purple);
    transform: translateX(-50%);
  }

  .roadmap-sections {
    display: grid;
    gap: 1.5rem;
    padding-left: 6.2rem;
  }

  .roadmap-section {
    position: relative;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgb(127 127 127 / 2%);
  }

  .roadmap-section.status-complete {
    border-color: rgb(80 192 112 / 28%);
    background:
      linear-gradient(145deg, rgb(80 192 112 / 7%), transparent 45%),
      rgb(127 127 127 / 2%);
  }

  .roadmap-section.status-current {
    border-color: rgb(240 240 0 / 30%);
    background:
      linear-gradient(145deg, rgb(240 240 0 / 6%), transparent 45%),
      rgb(127 127 127 / 2%);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(280px, 1.15fr);
    gap: 3rem;
    align-items: start;
  }

  .section-status {
    margin: 0 0 0.7rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .status-complete .section-status {
    color: var(--color-green-light);
  }

  .status-current .section-status {
    color: var(--color-yellow);
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .section-heading > p {
    max-width: 46rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .group-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .groups-1 {
    grid-template-columns: 1fr;
  }

  .groups-1 .roadmap-group ul {
