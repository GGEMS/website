    <meta name="description" content={pageDescriptions.en} />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <link rel="icon" type="image/png" href="/images/ggems-logo.png" />
    <link rel="apple-touch-icon" href="/images/ggems-logo.png" />

    <title>Roadmap — GGEMS</title>

    <script is:inline define:vars={{ supportedLanguages: languages }}>
      (() => {
        const storedTheme = localStorage.getItem('ggems-theme');
        const theme =
          storedTheme ??
          (window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark');

        document.documentElement.dataset.theme = theme;

        const storedLang = localStorage.getItem('ggems-language');
        const lang =
          storedLang && supportedLanguages.includes(storedLang)
            ? storedLang
            : 'en';

        document.documentElement.lang = lang;
        document.documentElement.dataset.lang = lang;
      })();
    </script>
  </head>

