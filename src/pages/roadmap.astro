    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeButton = document.querySelector('.theme-toggle');
        const languageButtons = document.querySelectorAll('[data-language]');
        const description = document.querySelector('meta[name="description"]');

        const updateMetadata = () => {
          if (root.dataset.lang === 'fr') {
            document.title = 'Roadmap — GGEMS';
            description?.setAttribute(
              'content',
              'Suivez la roadmap de développement de GGEMS jusqu’à la première version publique.'
            );
          } else if (root.dataset.lang === 'de') {
            document.title = 'Roadmap — GGEMS';
            description?.setAttribute(
              'content',
              'Verfolgen Sie die GGEMS-Entwicklungsroadmap bis zur ersten öffentlichen Version.'
            );
          } else if (root.dataset.lang === 'it') {
            document.title = 'Roadmap — GGEMS';
            description?.setAttribute(
              'content',
              'Segui la roadmap di sviluppo di GGEMS fino alla prima versione pubblica.'
            );
          } else if (root.dataset.lang === 'es') {
            document.title = 'Roadmap — GGEMS';
            description?.setAttribute(
              'content',
              'Sigue la hoja de ruta de desarrollo de GGEMS hasta la primera versión pública.'
            );
          } else if (root.dataset.lang === 'pt-BR') {
            document.title = 'Roadmap — GGEMS';
            description?.setAttribute(
              'content',
              'Acompanhe o roadmap de desenvolvimento do GGEMS até a primeira versão pública.'
            );
          } else {
            document.title = 'Roadmap — GGEMS';
            description?.setAttribute(
              'content',
              'Follow the GGEMS development roadmap toward the first public release.'
            );
          }
        };

        const setLanguage = (lang) => {
          root.dataset.lang = lang;
          root.lang = lang;
          localStorage.setItem('ggems-language', lang);

          languageButtons.forEach((button) => {
            button.classList.toggle('active', button.dataset.language === lang);
          });

          document.querySelector('.language-switcher')?.removeAttribute('open');
          updateMetadata();
        };

        languageButtons.forEach((button) => {
          button.addEventListener('click', () => setLanguage(button.dataset.language));
        });

        themeButton?.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = nextTheme;
          localStorage.setItem('ggems-theme', nextTheme);
        });

        setLanguage(
          ['en', 'fr', 'de', 'it', 'es', 'pt-BR'].includes(root.dataset.lang)
            ? root.dataset.lang
            : 'en'
        );
      })();
    </script>
