---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="GGEMS — Design System"
  description="GGEMS website design system."
  noIndex={true}
>
  <main>
    <section class="section">
      <div class="container intro">
        <p class="eyebrow">GGEMS · Design system</p>

        <h1 class="display">
          Scientific.
          <span>Modern.</span>
          GPU-first.
        </h1>

        <p class="lead">
          Visual language for the GGEMS project website.
          Space Grotesk provides the editorial voice while JetBrains Mono
          carries technical information, labels and numerical content.
        </p>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <p class="eyebrow">01 · Color</p>
        <h2 class="heading-1">GGEMS palette</h2>

        <div class="palette">
          <article class="swatch swatch-background">
            <div class="swatch-color"></div>
            <div class="swatch-info">
              <strong>Background</strong>
              <code>#07111B</code>
            </div>
          </article>

          <article class="swatch swatch-surface">
            <div class="swatch-color"></div>
            <div class="swatch-info">
              <strong>Surface</strong>
              <code>#0B1723</code>
            </div>
          </article>

          <article class="swatch swatch-green">
            <div class="swatch-color"></div>
            <div class="swatch-info">
              <strong>GGEMS Green</strong>
              <code>#50C070</code>
            </div>
          </article>

          <article class="swatch swatch-green-light">
            <div class="swatch-color"></div>
            <div class="swatch-info">
              <strong>Green Light</strong>
              <code>#80D0A0</code>
            </div>
          </article>

          <article class="swatch swatch-purple">
            <div class="swatch-color"></div>
            <div class="swatch-info">
              <strong>Orbit Purple</strong>
              <code>#8020E0</code>
            </div>
          </article>

          <article class="swatch swatch-yellow">
            <div class="swatch-color"></div>
            <div class="swatch-info">
              <strong>Particle Yellow</strong>
              <code>#F0F000</code>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container typography">
        <p class="eyebrow">02 · Typography</p>

        <div class="type-sample">
          <p class="type-label">Display · Space Grotesk 500</p>
          <p class="display">GPU Monte Carlo</p>
        </div>

        <div class="type-sample">
          <p class="type-label">Heading 1 · Space Grotesk 500</p>
          <p class="heading-1">Medical imaging and particle therapy</p>
        </div>

        <div class="type-sample">
          <p class="type-label">Heading 2 · Space Grotesk 500</p>
          <p class="heading-2">High-performance simulation</p>
        </div>

        <div class="type-sample text-sample">
          <p class="type-label">Lead text · Space Grotesk 400</p>
          <p class="lead">
            GGEMS is a GPU-oriented Monte Carlo simulation platform designed
            for medical imaging, dosimetry and particle transport.
          </p>
        </div>

        <div class="type-sample text-sample">
          <p class="type-label">Body · Space Grotesk 400</p>
          <p class="body-text">
            The website should remain editorial and readable while retaining
            a strong scientific and technical identity. Technical metadata,
            numerical values and compact interface elements use JetBrains Mono.
          </p>
        </div>

        <div class="type-sample">
          <p class="type-label">Technical · JetBrains Mono</p>
          <p class="technical">
            C++23 · OpenCL · GPU · Monte Carlo · 250 MeV · 10 µeV
          </p>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <p class="eyebrow">03 · Interface</p>
        <h2 class="heading-1">Buttons & links</h2>

        <div class="buttons">
          <a class="button button-primary" href="#buttons">Primary action</a>
          <a class="button button-secondary" href="#buttons">Secondary action</a>
          <a class="text-link" href="#buttons">
            Technical documentation
            <span>↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">04 · Surfaces</p>
        <h2 class="heading-1">Scientific cards</h2>

        <div class="cards">
          <article class="surface card">
            <p class="card-index">01</p>
            <h3>Medical imaging</h3>
            <p>
              CT, CBCT, PET and SPECT simulation workflows accelerated on
              modern GPU hardware.
            </p>
            <span class="card-accent green"></span>
          </article>

          <article class="surface card">
            <p class="card-index">02</p>
            <h3>Particle transport</h3>
            <p>
              Monte Carlo transport for photons, leptons and medically
              relevant charged and neutral particles.
            </p>
            <span class="card-accent purple"></span>
          </article>

          <article class="surface card">
            <p class="card-index">03</p>
            <h3>Dosimetry</h3>
            <p>
              High-performance dose calculation and scientific validation
              designed around GPU execution.
            </p>
            <span class="card-accent yellow"></span>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <p class="eyebrow">05 · Themes</p>
        <h2 class="heading-1">Dark & Light</h2>

        <div class="theme-grid">
          <article class="theme-preview theme-dark">
            <p class="theme-label">Dark</p>

            <h3>Scientific computing</h3>

            <p>
              Deep surfaces, high contrast and restrained GGEMS accents for
              technical work and immersive presentation.
            </p>

            <div class="theme-actions">
              <span class="theme-button">Primary</span>
              <span class="theme-link">Documentation ↗</span>
            </div>
          </article>

          <article class="theme-preview" data-theme="light">
            <p class="theme-label">Light</p>

            <h3>Scientific computing</h3>

            <p>
              Clear, paper-like surfaces designed for reading, documentation and
              daylight environments.
            </p>

            <div class="theme-actions">
              <span class="theme-button">Primary</span>
              <span class="theme-link">Documentation ↗</span>
            </div>
          </article>
        </div>
      </div>
    </section> 
  
    <section class="section final-section">
      <div class="container final">
        <p class="eyebrow">06 · Direction</p>
        <h2 class="heading-1">
          Clean enough for science.<br />
          Distinct enough to be GGEMS.
        </h2>

        <p class="lead">
          The interface stays quiet. GGEMS colors are reserved for meaning,
          motion and emphasis rather than decoration everywhere.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .intro {
    padding-top: 5rem;
  }

  .intro .display {
    max-width: 950px;
    margin-top: 1.5rem;
  }

  .intro .display span {
    color: var(--color-text-muted);
  }

  .intro .lead {
    max-width: 760px;
    margin-top: 2rem;
  }

  .section-dark {
    border-block: 1px solid var(--color-border);

    background:
      linear-gradient(
        135deg,
        rgb(255 255 255 / 2%),
        transparent 45%
      ),
      var(--color-bg-soft);
  }

  .section .heading-1 {
    margin-top: 1rem;
  }

  .palette {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;

    margin-top: 3rem;
  }

  .swatch {
    overflow: hidden;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);

    background: var(--color-surface);
  }

  .swatch-color {
    height: 140px;
  }

  .swatch-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;

    padding: 1rem 1.1rem;
  }

  .swatch-info strong {
    font-weight: 500;
  }

  .swatch-info code {
    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .swatch-background .swatch-color {
    background: var(--color-bg);
  }

  .swatch-surface .swatch-color {
    background: var(--color-surface-raised);
  }

  .swatch-green .swatch-color {
    background: var(--color-green);
  }

  .swatch-green-light .swatch-color {
    background: var(--color-green-light);
  }

  .swatch-purple .swatch-color {
    background: var(--color-purple);
  }

  .swatch-yellow .swatch-color {
    background: var(--color-yellow);
  }

  .typography {
    display: grid;
    gap: 4rem;
  }

  .typography > .eyebrow {
    margin-bottom: -2rem;
  }

  .type-sample {
    padding-bottom: 4rem;

    border-bottom: 1px solid var(--color-border);
  }

  .type-sample:last-child {
    border-bottom: 0;
  }

  .type-label {
    margin: 0 0 1.2rem;

    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  .text-sample {
    max-width: 800px;
  }

  .text-sample p:last-child {
    margin-bottom: 0;
  }

  .technical {
    margin: 0;

    color: var(--color-green-light);

    font-family: var(--font-mono);
    font-size: clamp(1rem, 2vw, 1.4rem);
    line-height: 1.7;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;

    margin-top: 3rem;
  }

  .button {
    padding: 0.9rem 1.25rem;

    border: 1px solid transparent;
    border-radius: var(--radius-sm);

    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;

    text-decoration: none;

    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: #06120a;
    background: var(--color-green);
  }

  .button-primary:hover {
    background: var(--color-green-light);
  }

  .button-secondary {
    color: var(--color-text);

    border-color: var(--color-border-strong);

    background: rgb(255 255 255 / 3%);
  }

  .button-secondary:hover {
    border-color: var(--color-purple);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    margin-left: 1rem;

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.8rem;

    text-decoration: none;
  }

  .text-link span {
    color: var(--color-purple);

    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translate(2px, -2px);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;

    margin-top: 3rem;
  }

  .card {
    position: relative;

    min-height: 310px;
    padding: 1.75rem;

    overflow: hidden;
  }

  .card-index {
    margin: 0;

    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .card h3 {
    margin: 4.5rem 0 0;

    font-size: 1.65rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .card p:not(.card-index) {
    margin: 1rem 0 0;

    color: var(--color-text-muted);

    line-height: 1.65;
  }

  .card-accent {
    position: absolute;
    right: 1.75rem;
    top: 1.75rem;

    width: 0.6rem;
    height: 0.6rem;

    border-radius: 50%;
  }

  .card-accent.green {
    background: var(--color-green);

    box-shadow: 0 0 1.5rem rgb(80 192 112 / 55%);
  }

  .card-accent.purple {
    background: var(--color-purple);

    box-shadow: 0 0 1.5rem rgb(128 32 224 / 55%);
  }

  .card-accent.yellow {
    background: var(--color-yellow);

    box-shadow: 0 0 1.5rem rgb(240 240 0 / 45%);
  }

  .final-section {
    padding-block: 10rem;
  }

  .final {
    max-width: 950px;
  }

  .final .heading-1 {
    margin-top: 1.5rem;
  }

  .final .lead {
    max-width: 700px;
    margin-top: 2rem;
  }

  @media (max-width: 900px) {
    .palette,
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .palette,
    .cards {
      grid-template-columns: 1fr;
    }

    .text-link {
      width: 100%;
      margin-top: 0.5rem;
      margin-left: 0;
    }
  }

.theme-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.5rem;

  margin-top: 3rem;
}

.theme-preview {
  min-height: 360px;
  padding: 2rem;

  color: var(--color-text);

  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);

  background:
    radial-gradient(
      circle at 90% 10%,
      rgb(80 192 112 / 9%),
      transparent 13rem
    ),
    var(--color-bg);
}

.theme-dark {
  background:
    radial-gradient(
      circle at 90% 10%,
      rgb(128 32 224 / 12%),
      transparent 13rem
    ),
    var(--color-bg);
}

.theme-label {
  margin: 0;

  color: var(--color-green-light);

  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.theme-preview h3 {
  margin: 4rem 0 0;

  font-size: 2rem;
  font-weight: 500;
  letter-spacing: -0.03em;
}

.theme-preview > p:not(.theme-label) {
  max-width: 32rem;
  margin: 1rem 0 0;

  color: var(--color-text-muted);

  line-height: 1.65;
}

.theme-actions {
  display: flex;
  align-items: center;
  gap: 1.5rem;

  margin-top: 2rem;

  font-family: var(--font-mono);
  font-size: 0.75rem;
}

.theme-button {
  padding: 0.75rem 1rem;

  color: #06120a;
  border-radius: var(--radius-sm);

  background: var(--color-green);
}

.theme-link {
  color: var(--color-text-muted);
}

@media (max-width: 720px) {
  .theme-grid {
    grid-template-columns: 1fr;
  }
}
</style>
