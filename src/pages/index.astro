---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="GGEMS — GPU Geant4-based Monte Carlo Simulations for medical imaging, dosimetry and particle therapy."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <link rel="icon" type="image/png" href="/images/ggems-logo.png" />
    <link rel="apple-touch-icon" href="/images/ggems-logo.png" />

    <title>GGEMS — Website in progress</title>

    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('ggems-theme');
        const theme =
          storedTheme ??
          (window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark');

        document.documentElement.dataset.theme = theme;

        const storedLang = localStorage.getItem('ggems-language');
        const supportedLanguages = ['en', 'fr', 'de', 'es', 'it', 'pt-BR', 'ru', 'zh-CN', 'ja'];

        if (storedLang && supportedLanguages.includes(storedLang)) {
          document.documentElement.lang = storedLang;
          document.documentElement.dataset.lang = storedLang;
        } else {
          document.documentElement.lang = 'en';
          document.documentElement.dataset.lang = 'en';
        }
      })();
    </script>
  </head>

