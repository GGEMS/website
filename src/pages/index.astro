    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeButton = document.querySelector('.theme-toggle');
        const languageButtons = document.querySelectorAll('[data-language]');

        const updateTitle = () => {
          if (root.dataset.lang === 'fr') {
            document.title = 'GGEMS — Nouveau site en préparation';
          } else if (root.dataset.lang === 'de') {
            document.title = 'GGEMS — Webseite im Aufbau';
          } else if (root.dataset.lang === 'it') {
            document.title = 'GGEMS — Sito in preparazione';
          } else if (root.dataset.lang === 'es') {
            document.title = 'GGEMS — Sitio web en preparación';
          } else if (root.dataset.lang === 'pt-BR') {
            document.title = 'GGEMS — Site em preparação';
          } else if (root.dataset.lang === 'ru') {
            document.title = 'GGEMS — сайт в разработке';
          } else if (root.dataset.lang === 'zh-CN') {
            document.title = 'GGEMS — 新网站建设中';
          } else if (root.dataset.lang === 'ja') {
            document.title = 'GGEMS — 新サイト構築中';
          } else {
            document.title = 'GGEMS — Website in progress';
          }
        };

        const setLanguage = (lang) => {
          root.dataset.lang = lang;
          root.lang = lang;
          localStorage.setItem('ggems-language', lang);

          languageButtons.forEach((button) => {
            button.classList.toggle('active', button.dataset.language === lang);
          });

          document.querySelector('.language-switcher')?.removeAttribute('open');

          updateTitle();
        };

        languageButtons.forEach((button) => {
          button.addEventListener('click', () => setLanguage(button.dataset.language));
        });

        themeButton?.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = nextTheme;
          localStorage.setItem('ggems-theme', nextTheme);
        });

        const supportedLanguages = ['en', 'fr', 'de', 'es', 'it', 'pt-BR', 'ru', 'zh-CN', 'ja'];
        setLanguage(
          supportedLanguages.includes(root.dataset.lang)
            ? root.dataset.lang
            : 'en'
        );
      })();
    </script>
