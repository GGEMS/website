---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="GGEMS 2 — GPU Geant4-based Monte Carlo Simulations for medical imaging, dosimetry and particle therapy."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <title>GGEMS 2 — Website under construction</title>
  </head>

  <body>
    <main>
      <section class="hero">
        <div class="visual" aria-hidden="true">
          <div class="glow"></div>
          <img src="/images/ggems-logo.png" alt="" />
        </div>

        <div class="content">
          <p class="eyebrow">GGEMS 2</p>

          <h1>
            A new GGEMS<br />
            website
            <span>is under construction.</span>
          </h1>

          <p class="lead">
            GPU Geant4-based Monte Carlo Simulations for medical imaging,
            dosimetry and particle therapy.
          </p>

          <div class="actions">
            <a class="primary" href="https://github.com/GGEMS/ggems">
              GitHub
            </a>

            <!--   <a class="secondary" href="https://forum.ggems-project.com/">
                  Forum
            </a> -->
          </div>

          <p class="status">
            <span></span>
            Website foundation online · Design in progress
          </p>
        </div>
      </section>
    </main>

    <footer>
      <span>GGEMS</span>
      <span>GPU Monte Carlo for medical physics</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --background: #07111b;
    --surface: #0b1723;
    --text: #f5f8fb;
    --muted: #aab7c5;

    --green: #50c070;
    --green-light: #80d0a0;
    --green-dark: #309050;
    --purple: #8020e0;
    --yellow: #f0f000;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--background);
  }

  body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;

    color: var(--text);
    background:
      radial-gradient(circle at 78% 25%, rgb(128 32 224 / 12%), transparent 32rem),
      radial-gradient(circle at 20% 80%, rgb(80 192 112 / 8%), transparent 28rem),
      var(--background);

    font-family: 'Space Grotesk', sans-serif;
  }

  main {
    min-height: calc(100vh - 5rem);
  }

  .hero {
    width: min(1180px, calc(100% - 3rem));
    min-height: calc(100vh - 5rem);
    margin: 0 auto;

    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 5rem;

    padding: 5rem 0;
  }

  .content {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    margin: 0 0 1.3rem;

    color: var(--green-light);

    font-family: 'JetBrains Mono', monospace;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 0;

    font-size: clamp(3.6rem, 5.7vw, 5.8rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  h1 span {
    display: block;
    margin-top: 0.28em;

    color: var(--muted);
    font-weight: 400;
  }

  .lead {
    max-width: 670px;
    margin: 2rem 0 0;

    color: var(--muted);

    font-size: clamp(1.08rem, 2vw, 1.32rem);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;

    margin-top: 2.3rem;
  }

  .actions a {
    padding: 0.88rem 1.3rem;

    border: 1px solid transparent;
    border-radius: 0.6rem;

    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88rem;
    font-weight: 500;

    text-decoration: none;

    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .actions a:hover {
    transform: translateY(-2px);
  }

  .primary {
    color: #06120a;
    background: var(--green);
  }

  .primary:hover {
    background: var(--green-light);
  }

  .secondary {
    color: var(--text);
    border-color: rgb(170 183 197 / 30%) !important;
    background: rgb(255 255 255 / 4%);
  }

  .secondary:hover {
    border-color: var(--purple) !important;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.65rem;

    margin-top: 2.4rem;

    color: #7f8c99;

    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
  }

  .status span {
    width: 0.5rem;
    height: 0.5rem;

    border-radius: 50%;
    background: var(--yellow);

    box-shadow: 0 0 1rem rgb(240 240 0 / 55%);
  }

  .visual {
    position: relative;

    display: grid;
    place-items: center;

    min-height: 520px;
  }

  .visual img {
    position: relative;
    z-index: 2;

    width: min(100%, 470px);
    height: auto;

    filter: drop-shadow(0 2rem 4rem rgb(0 0 0 / 38%));

    animation: float 7s ease-in-out infinite;
  }

  .glow {
    position: absolute;

    width: 72%;
    aspect-ratio: 1;

    border-radius: 50%;

    background:
      radial-gradient(circle, rgb(128 32 224 / 18%), transparent 62%);

    filter: blur(1.5rem);
  }

  footer {
    width: min(1180px, calc(100% - 3rem));
    height: 5rem;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;

    border-top: 1px solid rgb(255 255 255 / 8%);

    color: #72808e;

    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(-1deg);
    }

    50% {
      transform: translateY(-12px) rotate(1deg);
    }
  }

  @media (max-width: 850px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;

      padding-top: 4rem;
    }

    .visual {
      order: -1;
      min-height: auto;
    }

    .visual img {
      width: min(72vw, 360px);
    }

    h1 {
      font-size: clamp(2.8rem, 13vw, 5rem);
    }
  }

  @media (max-width: 520px) {
    .hero,
    footer {
      width: min(100% - 2rem, 1180px);
    }

    footer {
      height: auto;
      padding: 1.5rem 0;

      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .visual img {
      animation: none;
    }

    .actions a {
      transition: none;
    }
  }
</style>

