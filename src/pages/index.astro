---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

const languages = ['en', 'fr', 'de', 'it', 'es', 'pt-BR', 'ru', 'zh-CN', 'ja', 'ko'] as const;
type Language = (typeof languages)[number];

const pageTitles: Record<Language, string> = {
  en: 'GGEMS — Website in progress',
  fr: 'GGEMS — Nouveau site en préparation',
  de: 'GGEMS — Website im Aufbau',
  it: 'GGEMS — Sito in preparazione',
  es: 'GGEMS — Sitio web en preparación',
  'pt-BR': 'GGEMS — Site em preparação',
  ru: 'GGEMS — сайт в разработке',
  'zh-CN': 'GGEMS — 新网站建设中',
  ja: 'GGEMS — 新サイト構築中',
  ko: 'GGEMS — 새 웹사이트 준비 중',
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="GGEMS — GPU Geant4-based Monte Carlo Simulations for medical imaging, dosimetry and particle therapy."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <link rel="icon" type="image/png" href="/images/ggems-logo.png" />
    <link rel="apple-touch-icon" href="/images/ggems-logo.png" />

    <title>{pageTitles.en}</title>

    <script is:inline define:vars={{ supportedLanguages: languages }}>
      (() => {
        const storedTheme = localStorage.getItem('ggems-theme');
        const theme =
          storedTheme ??
          (window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark');

        document.documentElement.dataset.theme = theme;

        const storedLang = localStorage.getItem('ggems-language');
        const lang =
          storedLang && supportedLanguages.includes(storedLang)
            ? storedLang
            : 'en';

        document.documentElement.lang = lang;
        document.documentElement.dataset.lang = lang;
      })();
    </script>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="GGEMS home">
          <img src="/images/ggems-logo.png" alt="" />
