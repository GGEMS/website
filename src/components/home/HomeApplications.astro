---
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section applications">
  <div class="container">
    <div class="applications-heading">
      <p class="eyebrow">{t('applications.eyebrow')}</p>
    </div>

    <div class="application-list">
      <article class="application">
        <div class="application-copy">
          <h3>{t('applications.ct.title')}</h3>

          <p>
            {t('applications.ct.body')}
          </p>
        </div>

        <div class="application-visual visual-green">
          <span>CT · CBCT</span>
        </div>
      </article>

      <article class="application application-reverse">
        <div class="application-copy">
          <h3>{t('applications.pet.title')}</h3>

          <p>
            {t('applications.pet.body')}
          </p>
        </div>

        <div class="application-visual visual-purple">
          <span>PET · SPECT</span>
        </div>
      </article>

      <article class="application">
        <div class="application-copy">
          <h3>{t('applications.dosimetry.title')}</h3>

          <p>
            {t('applications.dosimetry.body')}
          </p>
        </div>

        <div class="application-visual visual-yellow">
          <span>{t('applications.dosimetry.visual')}</span>
        </div>
      </article>

      <article class="application application-reverse">
        <div class="application-copy">
          <h3>{t('applications.therapy.title')}</h3>

          <p>
            {t('applications.therapy.body')}
          </p>
        </div>

        <div class="application-visual visual-mixed">
          <span>{t('applications.therapy.visual')}</span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .applications-heading {
    max-width: 820px;
  }

  .application-list {
    margin-top: 3rem;
  }

  .application {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    align-items: center;
    gap: clamp(2rem, 3vw, 3rem);

    padding-block: 2.5rem;
  }

  .application-reverse {
    grid-template-columns: minmax(0, 1.28fr) minmax(280px, 0.72fr);
  }

  .application-reverse .application-copy {
    order: 2;
  }

  .application-reverse .application-visual {
    order: 1;
  }

  .application-copy {
    max-width: 31rem;
  }

  .application h3 {
    margin: 0;

    font-size: clamp(2rem, 3.5vw, 3.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .application-copy > p {
    margin: 1.5rem 0 0;

    color: var(--color-text-muted);

    line-height: 1.75;
  }

  .application-visual {
    position: relative;

    min-height: 320px;

    display: grid;
    place-items: center;

    overflow: hidden;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);

    background: var(--color-surface);
  }

  .application-visual::before,
  .application-visual::after {
    content: '';

    position: absolute;

    border-radius: 50%;
  }

  .application-visual::before {
    width: 17rem;
    height: 17rem;

    border: 1px solid var(--color-visual-line);
  }

  .application-visual::after {
    width: 25rem;
    height: 9rem;

    border: 1px solid var(--color-visual-line-soft);

    transform: rotate(-18deg);
  }

  .application-visual span {
    position: relative;
    z-index: 2;

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  .visual-green {
    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(80 192 112 / 16%),
        transparent 18rem
      ),
      var(--color-surface);
  }

  .visual-purple {
    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(128 32 224 / 18%),
        transparent 18rem
      ),
      var(--color-surface);
  }

  .visual-yellow {
    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(240 240 0 / 10%),
        transparent 18rem
      ),
      var(--color-surface);
  }

  .visual-mixed {
    background:
      radial-gradient(
        circle at 38% 45%,
        rgb(80 192 112 / 13%),
        transparent 14rem
      ),
      radial-gradient(
        circle at 65% 55%,
        rgb(128 32 224 / 16%),
        transparent 16rem
      ),
      var(--color-surface);
  }

  @media (max-width: 900px) {
    .application,
    .application-reverse {
      grid-template-columns: 1fr;
      gap: 2rem;

      padding-block: 2.25rem;
    }

    .application-reverse .application-copy,
    .application-reverse .application-visual {
      order: initial;
    }

    .application-visual {
      min-height: 300px;
    }
  }
</style>
