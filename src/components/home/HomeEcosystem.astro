---
import type { Lang } from '../../i18n/config';
import { useEcosystemTranslations } from '../../i18n/ecosystem';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useEcosystemTranslations(lang);

const resources = [
  {
    label: t('ecosystem.source.label'),
    service: 'GitHub',
    body: t('ecosystem.source.body'),
    displayUrl: 'github.com/GGEMS/ggems',
    href: 'https://github.com/GGEMS/ggems',
  },
  {
    label: t('ecosystem.docs.label'),
    service: 'Sphinx',
    body: t('ecosystem.docs.body'),
    displayUrl: 'docs.ggems-project.com',
    href: 'https://docs.ggems-project.com',
  },
  {
    label: t('ecosystem.api.label'),
    service: 'Doxygen',
    body: t('ecosystem.api.body'),
    displayUrl: 'api.ggems-project.com',
    href: 'https://api.ggems-project.com',
  },
  {
    label: t('ecosystem.community.label'),
    service: 'Discourse',
    body: t('ecosystem.community.body'),
    displayUrl: 'forum.ggems-project.com',
    href: 'https://forum.ggems-project.com',
  },
];
---

<section class="section home-ecosystem">
  <div class="container">
    <div class="ecosystem-heading">
      <p class="eyebrow">{t('ecosystem.eyebrow')}</p>
      <h2 class="heading-1">{t('ecosystem.title')}</h2>
      <p class="lead">{t('ecosystem.lead')}</p>
    </div>

    <div class="ecosystem-resources">
      {resources.map((resource) => (
        <a class="ecosystem-resource" href={resource.href}>
          <span class="resource-label">{resource.label}</span>

          <div class="resource-heading">
            <h3>{resource.service}</h3>
            <span class="resource-arrow" aria-hidden="true">↗</span>
          </div>

          <p>{resource.body}</p>
          <span class="resource-url">{resource.displayUrl}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .home-ecosystem {
    position: relative;
    overflow: hidden;
  }

  .ecosystem-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.35rem;
    align-items: start;
  }

  .ecosystem-heading > .eyebrow {
    grid-area: eyebrow;
  }

  .ecosystem-heading .heading-1 {
    grid-area: title;
    margin: 0;
  }

  .ecosystem-heading .lead {
    grid-area: lead;
    margin: 0;
  }

  .ecosystem-resources {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;

    margin-top: 4rem;
  }

  .ecosystem-resource {
    min-width: 0;
    padding: 1.7rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    color: var(--color-text);
    background: rgb(127 127 127 / 2%);

    text-decoration: none;

    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .ecosystem-resource:hover {
    border-color: var(--color-border-strong);
    background: var(--color-control-hover);
    transform: translateY(-2px);
  }

  .resource-label {
    color: var(--color-green-light);

    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .resource-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;

    margin-top: 1.15rem;
  }

  .resource-heading h3 {
    margin: 0;

    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .resource-arrow {
    flex: 0 0 auto;

    color: var(--color-purple);

    font-family: var(--font-mono);
    font-size: 0.9rem;

    transition: transform var(--transition-fast);
  }

  .ecosystem-resource:hover .resource-arrow {
    transform: translate(2px, -2px);
  }

  .ecosystem-resource p {
    min-height: 5.4rem;
    margin: 1rem 0 0;

    color: var(--color-text-muted);

    font-size: 0.95rem;
    line-height: 1.65;
  }

  .resource-url {
    display: block;
    overflow: hidden;

    margin-top: 1.4rem;

    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 980px) {
    .ecosystem-resources {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .ecosystem-heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .ecosystem-heading .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }
  }

  @media (max-width: 620px) {
    .ecosystem-resources {
      grid-template-columns: 1fr;
      margin-top: 3rem;
    }

    .ecosystem-resource p {
      min-height: 0;
    }
  }
</style>
