---
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="eyebrow">{t('hero.eyebrow')}</p>

      <h1>
        {t('hero.title.primary')}
        <span>{t('hero.title.secondary')}</span>
      </h1>

      <p class="hero-lead">
        {t('hero.lead')}
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="#objective">
          {t('hero.discover')}
        </a>

        <a
          class="button button-secondary"
          href="https://github.com/GGEMS/ggems"
        >
          {t('nav.github')}
          <span>↗</span>
        </a>
      </div>

      <div class="hero-meta">
        <span>GPL-3.0</span>
        <span>{t('hero.gpuFirst')}</span>
        <span>OpenCL</span>
        <span>Vulkan</span>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="orbit-glow"></div>

      <img src="/images/ggems-logo.png" alt="" />
    </div>
  </div>

  <div class="hero-line"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(860px, calc(100svh - 5.25rem));
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 77% 42%, rgb(128 32 224 / 11%), transparent 28rem),
      radial-gradient(circle at 21% 74%, rgb(80 192 112 / 6%), transparent 25rem);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    min-height: 680px;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    align-items: center;
    gap: 5rem;
    padding-block: 5rem;
  }

  .hero-content {
    max-width: 760px;
  }

  .hero h1 {
    margin: 1.7rem 0 0;
    font-size: clamp(4rem, 7vw, 7.4rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .hero h1 span {
    display: block;
    margin-top: 0.15em;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .hero-lead {
    max-width: 650px;
    margin: 2.2rem 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: #06120a;
    background: var(--color-green);
  }

  .button-primary:hover {
    background: var(--color-green-light);
  }

  .button-secondary {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    background: var(--color-control-bg);
  }

  .button-secondary:hover {
    border-color: var(--color-purple);
    background: var(--color-control-hover);
  }

  .button-secondary span {
    color: var(--color-purple);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 3.5rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .hero-meta span {
    display: inline-flex;
    align-items: center;
  }

  .hero-meta span:not(:last-child)::after {
    content: '·';
    margin-inline: 0.8rem;
    color: var(--color-green);
  }

  .hero-visual {
    position: relative;
    min-height: 540px;
    display: grid;
    place-items: center;
  }

  .hero-visual img {
    position: relative;
    z-index: 3;
    width: min(100%, 520px);
    height: auto;
    filter: drop-shadow(0 2.4rem 4.5rem var(--color-logo-shadow));
    animation: logo-float 8s ease-in-out infinite;
  }

  .orbit-glow {
    position: absolute;
    z-index: 1;
    width: 88%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(128 32 224 / 28%) 0%,
        rgb(128 32 224 / 16%) 34%,
        transparent 68%
      ),
      radial-gradient(
        circle at 42% 58%,
        rgb(80 192 112 / 10%) 0%,
        transparent 54%
      );
    filter: blur(2.3rem);
  }

  :global([data-theme='light']) .orbit-glow {
    width: 82%;
    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(128 32 224 / 13%) 0%,
        rgb(128 32 224 / 7%) 36%,
        transparent 68%
      ),
      radial-gradient(
        circle at 42% 58%,
        rgb(80 192 112 / 6%) 0%,
        transparent 54%
      );
    filter: blur(2rem);
  }

  .hero-line {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(var(--content-width), calc(100% - 3rem));
    height: 1px;
    transform: translateX(-50%);
    background:
      linear-gradient(
        90deg,
        transparent,
        var(--color-border-strong) 15%,
        var(--color-border-strong) 85%,
        transparent
      );
  }

  @keyframes logo-float {
    0%,
    100% {
      transform: translateY(0) rotate(-1deg);
    }

    50% {
      transform: translateY(-14px) rotate(1deg);
    }
  }

  @media (max-width: 1120px) {
    .hero {
      min-height: auto;
    }

    .hero-inner {
      min-height: 620px;

      grid-template-columns: minmax(0, 1fr) minmax(280px, 0.82fr);
      gap: 3rem;

      padding-block: 4rem;
    }

    .hero h1 {
      font-size: clamp(3.8rem, 7vw, 5.9rem);
    }

    .hero-visual {
      min-height: 420px;
    }

    .hero-visual img {
      width: min(100%, 430px);
    }
  }

  @media (max-width: 860px) {
    .hero-inner {
      min-height: 0;

      grid-template-columns: 1fr;
      gap: 2.5rem;

      padding-block: 4rem;
    }

    .hero-content {
      max-width: 680px;
    }

    .hero-visual {
      min-height: 300px;
    }

    .hero-visual img {
      width: min(70vw, 360px);
    }

    .orbit-glow {
      width: min(64vw, 320px);
      opacity: 0.72;
      filter: blur(1.8rem);
    }
  }

  @media (max-width: 620px) {
    .hero-inner {
      padding-block: 3rem;
    }

    .hero h1 {
      font-size: clamp(3.2rem, 15vw, 4.8rem);
    }

    .hero-lead {
      margin-top: 1.7rem;
    }

    .hero-actions {
      margin-top: 2rem;
    }

    .hero-meta {
      row-gap: 0.45rem;
      margin-top: 2.5rem;
    }

    .hero-meta span:not(:last-child)::after {
      margin-inline: 0.55rem;
    }

    .hero-visual {
      min-height: 250px;
    }

    .orbit-glow {
      width: min(58vw, 260px);
      opacity: 0.58;
      filter: blur(1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual img {
      animation: none;
    }
  }
</style>
