---
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="objective" class="section objective">
  <div class="container objective-grid">
    <p class="eyebrow">{t('objective.eyebrow')}</p>

    <h2 class="heading-1 objective-title">
      {t('objective.title.primary')}<br />
      {t('objective.title.secondary')}
    </h2>

    <div class="objective-copy">
      <p class="lead">
        {t('objective.lead')}
      </p>

      <p class="body-text">
        {t('objective.body')}
      </p>

      <a
        class="text-link"
        href="https://github.com/GGEMS/ggems"
      >
        {t('objective.explore')}
        <span>↗</span>
      </a>
    </div>
  </div>

  <div class="container pillars-wrap">
    <div class="pillars">
      <article class="pillar">
        <h3>{t('pillar.gpu.title')}</h3>
        <p>{t('pillar.gpu.body')}</p>
      </article>

      <article class="pillar">
        <h3>{t('pillar.physics.title')}</h3>
        <p>{t('pillar.physics.body')}</p>
      </article>

      <article class="pillar">
        <h3>{t('pillar.open.title')}</h3>
        <p>{t('pillar.open.body')}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .objective-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    grid-template-areas:
      'eyebrow .'
      'title copy';
    column-gap: 7rem;
    row-gap: 1.4rem;
    align-items: start;
  }

  .objective-grid > .eyebrow {
    grid-area: eyebrow;
  }

  .objective-title {
    grid-area: title;

    max-width: 12ch;
    margin: 0;
  }

  .objective-copy {
    grid-area: copy;
  }

  .objective-copy .lead {
    margin: 0;
  }

  .objective-copy .body-text {
    margin: 1.8rem 0 0;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2rem;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-decoration: none;
  }

  .text-link span {
    color: var(--color-purple);
    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translate(2px, -2px);
  }

  .pillars-wrap {
    margin-top: 3.5rem;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }

  .pillar {
    min-width: 0;
  }

  .pillar h3 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .pillar p {
    max-width: 21rem;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  @media (max-width: 940px) {
    .objective-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'copy';
      gap: 1.4rem;
    }

    .objective-copy {
      max-width: 680px;
      margin-top: 1.1rem;
    }
  }

  @media (max-width: 720px) {
    .pillars-wrap {
      margin-top: 3rem;
    }

    .pillars {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .pillar p {
      max-width: 38rem;
    }
  }
</style>
