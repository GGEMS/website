---
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="objective" class="section objective">
  <div class="container objective-grid">
    <div>
      <p class="eyebrow">{t('objective.eyebrow')}</p>

      <h2 class="heading-1">
        {t('objective.title.primary')}<br />
        <span>{t('objective.title.secondary')}</span>
      </h2>
    </div>

    <div class="objective-copy">
      <p class="lead">
        {t('objective.lead')}
      </p>

      <p class="body-text">
        {t('objective.body')}
      </p>

      <a
        class="text-link"
        href="https://github.com/GGEMS/ggems"
      >
        {t('objective.explore')}
        <span>↗</span>
      </a>
    </div>
  </div>

  <div class="container pillars-wrap">
    <div class="pillars">
      <article class="pillar">
        <div class="pillar-top">
          <span class="pillar-dot green"></span>
        </div>

        <h3>{t('pillar.gpu.title')}</h3>

        <p>
          {t('pillar.gpu.body')}
        </p>
      </article>

      <article class="pillar">
        <div class="pillar-top">
          <span class="pillar-dot purple"></span>
        </div>

        <h3>{t('pillar.physics.title')}</h3>

        <p>
          {t('pillar.physics.body')}
        </p>
      </article>

      <article class="pillar">
        <div class="pillar-top">
          <span class="pillar-dot yellow"></span>
        </div>

        <h3>{t('pillar.open.title')}</h3>

        <p>
          {t('pillar.open.body')}
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .objective-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    gap: 7rem;
  }

  .objective .heading-1 {
    margin-top: 1.4rem;
  }

  .objective .heading-1 span {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .objective-copy {
    padding-top: 2.2rem;
  }

  .objective-copy .lead {
    margin: 0;
  }

  .objective-copy .body-text {
    margin: 1.8rem 0 0;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;

    margin-top: 2rem;

    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.78rem;

    text-decoration: none;
  }

  .text-link span {
    color: var(--color-purple);

    transition: transform var(--transition-fast);
  }

  .text-link:hover span {
    transform: translate(2px, -2px);
  }

  .pillars-wrap {
    margin-top: 6rem;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));

    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .pillar {
    min-height: 360px;

    padding: 2rem;

    border-right: 1px solid var(--color-border);
  }

  .pillar:last-child {
    border-right: 0;
  }

  .pillar-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .pillar-dot {
    width: 0.55rem;
    height: 0.55rem;

    border-radius: 50%;
  }

  .pillar-dot.green {
    background: var(--color-green);

    box-shadow: 0 0 1.5rem rgb(80 192 112 / 50%);
  }

  .pillar-dot.purple {
    background: var(--color-purple);

    box-shadow: 0 0 1.5rem rgb(128 32 224 / 50%);
  }

  .pillar-dot.yellow {
    background: var(--color-yellow);

    box-shadow: 0 0 1.5rem rgb(240 240 0 / 40%);
  }

  .pillar h3 {
    margin: 7rem 0 0;

    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .pillar p {
    max-width: 20rem;

    margin: 1.1rem 0 0;

    color: var(--color-text-muted);

    line-height: 1.7;
  }

  @media (max-width: 940px) {
    .objective-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .objective-copy {
      max-width: 680px;
      padding-top: 0;
    }
  }

  @media (max-width: 720px) {
    .pillars {
      grid-template-columns: 1fr;
    }

    .pillar {
      min-height: auto;

      padding-block: 2.5rem;

      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .pillar:last-child {
      border-bottom: 0;
    }

    .pillar h3 {
      margin-top: 4rem;
    }
  }
</style>
