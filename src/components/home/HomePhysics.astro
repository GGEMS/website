---
import { localizedPath, type Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const electronLabel = lang === 'fr' ? 'Électron' : 'Electron';
const positronLabel = 'Positron';

const particles = [
  {
    symbol: 'γ',
    label: t('homePhysics.gamma'),
    accent: 'green',
    symbolClass: 'gamma',
  },
  {
    symbol: 'β−',
    label: electronLabel,
    accent: 'purple',
    symbolClass: 'beta',
  },
  {
    symbol: 'β+',
    label: positronLabel,
    accent: 'purple',
    symbolClass: 'beta',
  },
  {
    symbol: 'p',
    label: t('homePhysics.proton'),
    accent: 'green',
    symbolClass: 'nucleon',
  },
  {
    symbol: 'n',
    label: t('homePhysics.neutron'),
    accent: 'purple',
    symbolClass: 'nucleon',
  },
  {
    symbol: 'α',
    label: t('homePhysics.alpha'),
    accent: 'yellow',
    symbolClass: 'alpha',
  },
];
---

<section class="section home-physics">
  <div class="container">
    <div class="physics-heading">
      <div>
        <p class="eyebrow">{t('homePhysics.eyebrow')}</p>

        <h2 class="heading-1">{t('homePhysics.title.primary')}</h2>
      </div>

      <p class="lead">
        {t('homePhysics.lead')}
      </p>
    </div>

    <div class="particle-grid">
      {
        particles.map((particle) => (
          <article class={`particle-card ${particle.accent}`}>
            <div class="particle-orb">
              <div class={`particle-symbol ${particle.symbolClass}`}>{particle.symbol}</div>
            </div>
            <p>{particle.label}</p>
          </article>
        ))
      }
    </div>

    <div class="physics-footer">
      <p>
        {t('homePhysics.note')}
      </p>

      <a href={localizedPath('/physics/', lang)}>
        {t('homePhysics.link')}
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .home-physics {
    border-top: 1px solid var(--color-border);

    background:
      radial-gradient(
        circle at 14% 42%,
        rgb(80 192 112 / 6%),
        transparent 24rem
      ),
      radial-gradient(
        circle at 88% 58%,
        rgb(128 32 224 / 7%),
        transparent 26rem
      ),
      var(--color-bg-soft);
  }

  .physics-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.95fr);
    align-items: end;
    gap: 4.5rem;
  }

  .physics-heading .heading-1 {
    margin-top: 1.4rem;
    max-width: 12ch;
  }

  .physics-heading .lead {
    margin: 0;
  }

  .particle-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));

    margin-top: 4.5rem;

    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .particle-card {
    position: relative;

    min-height: 260px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.35rem;

    padding: 2rem 1.25rem 1.6rem;

    border-right: 1px solid var(--color-border);

    text-align: center;
  }

  .particle-card:last-child {
    border-right: 0;
  }

  .particle-orb {
    position: relative;

    width: clamp(6.8rem, 8vw, 8.4rem);
    aspect-ratio: 1;

    display: grid;
    place-items: center;

    border-radius: 50%;

    border: 1px solid rgb(127 127 127 / 22%);

    background:
      radial-gradient(circle at 32% 28%, rgb(255 255 255 / 34%), transparent 30%),
      radial-gradient(circle at 68% 72%, rgb(255 255 255 / 8%), transparent 42%),
      linear-gradient(145deg, rgb(255 255 255 / 6%), rgb(255 255 255 / 1%));

    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 18%),
      inset 0 -10px 24px rgb(0 0 0 / 4%),
      0 12px 28px rgb(0 0 0 / 5%);

    overflow: hidden;
    isolation: isolate;
  }


  .particle-card.green .particle-orb {
    background:
      radial-gradient(circle at 32% 28%, rgb(255 255 255 / 34%), transparent 30%),
      radial-gradient(circle at 68% 72%, rgb(255 255 255 / 8%), transparent 42%),
      linear-gradient(145deg, rgb(80 192 112 / 10%), rgb(80 192 112 / 2%));
  }


  .particle-card.purple .particle-orb {
    background:
      radial-gradient(circle at 32% 28%, rgb(255 255 255 / 34%), transparent 30%),
      radial-gradient(circle at 68% 72%, rgb(255 255 255 / 8%), transparent 42%),
      linear-gradient(145deg, rgb(128 32 224 / 10%), rgb(128 32 224 / 2%));
  }


  .particle-card.yellow .particle-orb {
    background:
      radial-gradient(circle at 32% 28%, rgb(255 255 255 / 34%), transparent 30%),
      radial-gradient(circle at 68% 72%, rgb(255 255 255 / 8%), transparent 42%),
      linear-gradient(145deg, rgb(232 224 32 / 11%), rgb(232 224 32 / 2%));
  }


  .particle-symbol {
    position: relative;
    z-index: 1;

    color: var(--color-text);

    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .particle-symbol.gamma,
  .particle-symbol.alpha {
    font-size: clamp(2.9rem, 3.7vw, 4.2rem);
    letter-spacing: -0.05em;
  }

  .particle-symbol.beta {
    font-size: clamp(2.5rem, 3.2vw, 3.8rem);
    letter-spacing: -0.04em;
  }

  .particle-symbol.nucleon {
    font-size: clamp(3rem, 3.7vw, 4rem);
    letter-spacing: -0.05em;
  }

  .particle-card p {
    margin: 0;

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .physics-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 4rem;

    margin-top: 2.5rem;
  }

  .physics-footer p {
    max-width: 46rem;

    margin: 0;

    color: var(--color-text-subtle);

    font-size: 0.9rem;
    line-height: 1.7;
  }

  .physics-footer a {
    flex: 0 0 auto;

    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.78rem;

    text-decoration: none;
  }

  .physics-footer a span {
    color: var(--color-purple);

    transition: transform var(--transition-fast);
  }

  .physics-footer a:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 1100px) {
    .particle-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .particle-card {
      border-bottom: 1px solid var(--color-border);
    }

    .particle-card:nth-child(3n) {
      border-right: 0;
    }

    .particle-card:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
  }

  @media (max-width: 980px) {
    .physics-heading {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .physics-heading .lead {
      max-width: 44rem;
    }
  }

  @media (max-width: 640px) {
    .particle-grid {
      grid-template-columns: 1fr;
    }

    .particle-card,
    .particle-card:nth-child(3n) {
      min-height: 220px;

      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .particle-card:last-child {
      border-bottom: 0;
    }
  }
</style>
