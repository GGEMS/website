---
import { localizedPath, type Lang } from '../../i18n/config';
import { useHomeRoadmapTranslations } from '../../i18n/home-roadmap';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useHomeRoadmapTranslations(lang);
---

<section class="section home-roadmap">
  <div class="container">
    <div class="roadmap-heading">
      <p class="eyebrow">{t('eyebrow')}</p>
      <h2 class="heading-1">{t('title')}</h2>
      <p class="lead">{t('lead')}</p>
    </div>

    <div class="roadmap-grid">
      <article class="roadmap-card roadmap-done">
        <span class="stage-status">{t('status.done')}</span>
        <h3>{t('stage.done')}</h3>
      </article>

      <article class="roadmap-card roadmap-active">
        <span class="stage-status">{t('status.active')}</span>
        <h3>{t('stage.active')}</h3>

        <div class="next-milestone">
          <span class="next-label">{t('status.next')}</span>
          <strong>{t('stage.next')}</strong>
        </div>
      </article>

      <article class="roadmap-card roadmap-later">
        <span class="stage-status">{t('status.later')}</span>
        <h3>{t('stage.later')}</h3>
      </article>
    </div>

    <div class="roadmap-footer">
      <a href={localizedPath('/roadmap/', lang)}>
        {t('link')}
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .home-roadmap {
    position: relative;
    overflow: hidden;
  }

  .home-roadmap .container {
    position: relative;
    z-index: 1;
  }

  .roadmap-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.35rem;
    align-items: start;
  }

  .roadmap-heading > .eyebrow {
    grid-area: eyebrow;
  }

  .roadmap-heading .heading-1 {
    grid-area: title;
    margin: 0;
  }

  .roadmap-heading .lead {
    grid-area: lead;
    margin: 0;
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: 1fr 1.55fr 1fr;
    gap: 1rem;

    margin-top: 4.5rem;
  }

  .roadmap-card {
    min-height: 220px;

    display: grid;
    grid-template-rows: auto 1fr auto;

    padding: 1.7rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .roadmap-done {
    background:
      linear-gradient(
        145deg,
        rgb(80 192 112 / 13%),
        rgb(80 192 112 / 5%)
      );
  }

  .roadmap-active {
    background:
      radial-gradient(
        circle at 76% 62%,
        rgb(128 32 224 / 7%),
        transparent 15rem
      ),
      linear-gradient(
        145deg,
        rgb(240 240 0 / 13%),
        rgb(240 240 0 / 4%)
      );
  }

  .roadmap-later {
    background:
      linear-gradient(
        145deg,
        rgb(128 32 224 / 11%),
        rgb(128 32 224 / 4%)
      );
  }

  .stage-status,
  .next-label {
    width: fit-content;

    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .roadmap-done .stage-status {
    color: var(--color-green);
  }

  .roadmap-active .stage-status {
    color: #b8b800;
  }

  .roadmap-later .stage-status {
    color: var(--color-purple);
  }

  :global([data-theme='dark']) .roadmap-active .stage-status {
    color: var(--color-yellow);
  }

  .roadmap-card h3 {
    align-self: start;

    margin: 3.4rem 0 0;

    color: var(--color-text);

    font-size: clamp(1.08rem, 1.45vw, 1.32rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .next-milestone {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;

    margin-top: auto;
    padding-top: 1.15rem;

    border-top: 1px solid var(--color-border);
  }

  .next-label {
    color: var(--color-purple);
  }

  .next-milestone strong {
    color: var(--color-text);

    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .roadmap-footer {
    display: flex;
    justify-content: flex-end;

    margin-top: 2.25rem;
  }

  .roadmap-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.78rem;

    text-decoration: none;
  }

  .roadmap-footer a span {
    color: var(--color-purple);

    transition: transform var(--transition-fast);
  }

  .roadmap-footer a:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .roadmap-grid {
      grid-template-columns: 1fr;
      gap: 0.9rem;

      margin-top: 3rem;
    }

    .roadmap-card {
      min-height: 0;

      display: flex;
      flex-direction: column;

      padding: 1.5rem;
    }

    .roadmap-card h3 {
      margin-top: 1.8rem;
    }

    .next-milestone {
      margin-top: 1.6rem;
    }

    .roadmap-footer {
      justify-content: flex-start;

      margin-top: 1.8rem;
    }
  }

  @media (max-width: 820px) {
    .roadmap-heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .roadmap-heading .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }
  }

  @media (max-width: 560px) {
    .next-milestone {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
  }
</style>
