---
import { localizedPath, type Lang } from '../../i18n/config';
import { useRoadmapTranslations } from '../../i18n/roadmap';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useRoadmapTranslations(lang);

const steps = [
  { short: '01', label: t('critical.foundation'), accent: 'green' },
  { short: '02', label: t('critical.materials'), accent: 'green' },
  { short: '03', label: t('critical.cuts'), accent: 'green' },
  { short: '04', label: t('critical.navigation'), accent: 'purple' },
  { short: '05', label: t('critical.gamma'), accent: 'purple' },
  { short: '06', label: t('critical.transport'), accent: 'purple' },
  { short: '07', label: t('critical.scoring'), accent: 'yellow' },
];
---

<section class="section home-roadmap">
  <div class="container">
    <div class="roadmap-heading">
      <div>
        <p class="eyebrow">{t('home.eyebrow')}</p>

        <h2 class="heading-1">
          {t('home.title.primary')}
          <span>{t('home.title.secondary')}</span>
        </h2>
      </div>

      <div class="roadmap-intro">
        <p class="lead">{t('home.lead')}</p>

        <div class="audit-status">
          <span class="status-dot"></span>
          <span>{t('home.status')}</span>
        </div>
      </div>
    </div>

    <div class="critical-path" aria-label={t('critical.eyebrow')}>
      {
        steps.map((step) => (
          <div class="path-step">
            <span class={`node ${step.accent}`}></span>
            <span class="step-number">{step.short}</span>
            <span class="step-label">{step.label}</span>
          </div>
        ))
      }

      <div class="milestone">
        <span class="milestone-spark"></span>
        <span>{t('home.milestone')}</span>
      </div>
    </div>

    <div class="roadmap-footer">
      <p>{t('critical.milestone.note')}</p>

      <a href={localizedPath('/roadmap/', lang)}>
        {t('home.link')}
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .home-roadmap {
    position: relative;

    overflow: hidden;

    border-top: 1px solid var(--color-border);

    background:
      radial-gradient(circle at 12% 22%, rgb(80 192 112 / 8%), transparent 24rem),
      radial-gradient(circle at 82% 74%, rgb(128 32 224 / 8%), transparent 28rem),
      var(--color-bg-soft);
  }

  .home-roadmap::after {
    content: '';

    position: absolute;
    inset: 0;

    pointer-events: none;

    background-image:
      linear-gradient(rgb(128 128 128 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(128 128 128 / 4%) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent);
  }

  .home-roadmap .container {
    position: relative;
    z-index: 1;
  }

  .roadmap-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    align-items: end;
    gap: 5rem;
  }

  .roadmap-heading .heading-1 {
    margin-top: 1.4rem;
  }

  .roadmap-heading .heading-1 span {
    display: block;

    color: var(--color-text-muted);
    font-weight: 400;
  }

  .roadmap-intro .lead {
    margin: 0;
  }

  .audit-status {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;

    margin-top: 1.5rem;

    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;

    border-radius: 50%;

    background: var(--color-green);
    box-shadow: 0 0 1rem rgb(80 192 112 / 55%);
  }

  .critical-path {
    position: relative;

    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr)) minmax(180px, 1.25fr);

    margin-top: 4.5rem;

    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .critical-path::before {
    content: '';

    position: absolute;
    left: 3rem;
    right: 4rem;
    top: 2.45rem;

    height: 1px;

    background: linear-gradient(
      90deg,
      var(--color-green),
      var(--color-purple) 64%,
      var(--color-yellow)
    );
    opacity: 0.45;
  }

  .path-step,
  .milestone {
    position: relative;

    min-height: 190px;

    display: flex;
    flex-direction: column;

    padding: 1.5rem 1.15rem;

    border-right: 1px solid var(--color-border);
  }

  .path-step .node {
    position: relative;
    z-index: 2;

    width: 0.72rem;
    height: 0.72rem;

    margin-top: 0.6rem;

    border: 3px solid var(--color-bg-soft);
    border-radius: 50%;

    box-sizing: content-box;
  }

  .node.green {
    background: var(--color-green);
    box-shadow: 0 0 1rem rgb(80 192 112 / 45%);
  }

  .node.purple {
    background: var(--color-purple);
    box-shadow: 0 0 1rem rgb(128 32 224 / 45%);
  }

  .node.yellow {
    background: var(--color-yellow);
    box-shadow: 0 0 1rem rgb(240 240 0 / 30%);
  }

  .step-number {
    margin-top: 2.5rem;

    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .step-label {
    margin-top: auto;

    color: var(--color-text);

    font-size: 0.98rem;
    line-height: 1.35;
  }

  .milestone {
    justify-content: flex-end;

    border-right: 0;

    background: linear-gradient(135deg, rgb(240 240 0 / 4%), transparent 60%);
  }

  .milestone-spark {
    position: absolute;
    top: 2.15rem;
    left: 1.35rem;

    width: 1rem;
    height: 1rem;

    border-radius: 50%;

    background: var(--color-yellow);
    box-shadow:
      0 0 0 0.35rem rgb(240 240 0 / 10%),
      0 0 1.5rem rgb(240 240 0 / 35%);
  }

  .milestone span:last-child {
    max-width: 12rem;

    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.55;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .roadmap-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;

    margin-top: 2.5rem;
  }

  .roadmap-footer p {
    margin: 0;

    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .roadmap-footer a {
    flex: 0 0 auto;

    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.78rem;

    text-decoration: none;
  }

  .roadmap-footer a span {
    color: var(--color-purple);

    transition: transform var(--transition-fast);
  }

  .roadmap-footer a:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 1120px) {
    .critical-path {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .critical-path::before {
      display: none;
    }

    .path-step,
    .milestone {
      min-height: 170px;
      border-bottom: 1px solid var(--color-border);
    }

    .path-step:nth-child(4),
    .milestone {
      border-right: 0;
    }

    .path-step:nth-child(n + 5),
    .milestone {
      border-bottom: 0;
    }
  }

  @media (max-width: 820px) {
    .roadmap-heading {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .roadmap-heading .lead {
      max-width: 44rem;
    }

    .critical-path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .path-step,
    .milestone,
    .path-step:nth-child(4) {
      border-right: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .path-step:nth-child(even),
    .milestone {
      border-right: 0;
    }

    .milestone {
      border-bottom: 0;
    }

    .roadmap-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
    }
  }

  @media (max-width: 520px) {
    .critical-path {
      grid-template-columns: 1fr;
    }

    .path-step,
    .path-step:nth-child(even),
    .path-step:nth-child(4),
    .milestone {
      min-height: 145px;

      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .milestone {
      border-bottom: 0;
    }
  }
</style>
