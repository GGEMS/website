---
import { localizedPath, type Lang } from '../../i18n/config';
import { useHomeRoadmapTranslations } from '../../i18n/home-roadmap';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useHomeRoadmapTranslations(lang);
---

<section class="section home-roadmap">
  <div class="container">
    <div class="roadmap-heading">
      <p class="eyebrow">{t('eyebrow')}</p>
      <h2 class="heading-1">{t('title')}</h2>
      <p class="lead">{t('lead')}</p>
    </div>

    <div class="roadmap-track">
      <article class="roadmap-stage status-done">
        <div class="stage-status">
          <span class="status-marker" aria-hidden="true"></span>
          <span>{t('status.done')}</span>
        </div>

        <div class="stage-track" aria-hidden="true">
          <span class="stage-node"></span>
        </div>

        <h3>{t('stage.done')}</h3>
      </article>

      <article class="roadmap-stage status-active">
        <div class="stage-status">
          <span class="status-marker" aria-hidden="true"></span>
          <span>{t('status.active')}</span>
        </div>

        <div class="stage-track active-track" aria-hidden="true">
          <svg
            class="progress-wave"
            viewBox="0 0 100 28"
            preserveAspectRatio="none"
            role="presentation"
          >
            <path
              d="M3 14 C10 0 20 28 30 14 S52 0 62 14 S84 28 97 14"
            />
          </svg>
          <span class="stage-node"></span>
        </div>

        <h3>{t('stage.active')}</h3>

        <div class="next-milestone">
          <div class="next-label">
            <span class="next-marker" aria-hidden="true"></span>
            <span>{t('status.next')}</span>
          </div>

          <strong>{t('stage.next')}</strong>
        </div>
      </article>

      <article class="roadmap-stage status-later">
        <div class="stage-status">
          <span class="status-marker" aria-hidden="true"></span>
          <span>{t('status.later')}</span>
        </div>

        <div class="stage-track" aria-hidden="true">
          <span class="stage-node"></span>
        </div>

        <h3>{t('stage.later')}</h3>
      </article>
    </div>

    <div class="roadmap-footer">
      <a href={localizedPath('/roadmap/', lang)}>
        {t('link')}
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .home-roadmap {
    position: relative;
    overflow: hidden;
  }

  .home-roadmap .container {
    position: relative;
    z-index: 1;
  }

  .roadmap-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.35rem;
    align-items: start;
  }

  .roadmap-heading > .eyebrow {
    grid-area: eyebrow;
  }

  .roadmap-heading .heading-1 {
    grid-area: title;

    margin: 0;
  }

  .roadmap-heading .lead {
    grid-area: lead;

    margin: 0;
  }

  .roadmap-track {
    position: relative;

    display: grid;
    grid-template-columns: 1fr 2fr 1fr;

    margin-top: 4.5rem;

  }

  .roadmap-stage {
    --status-color: var(--color-text-subtle);
    --status-glow: rgb(114 128 142 / 20%);

    position: relative;

    min-height: 230px;

    display: flex;
    flex-direction: column;

    padding: 1.45rem 1.55rem 1.7rem;

  }

  .status-done {
    --status-color: var(--color-green);
    --status-glow: rgb(80 192 112 / 32%);
  }

  .status-active {
    --status-color: var(--color-yellow);
    --status-glow: rgb(240 240 0 / 28%);
  }

  .stage-status,
  .next-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;

    width: fit-content;

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .status-marker,
  .next-marker {
    width: 0.5rem;
    height: 0.5rem;

    flex: 0 0 auto;

    border-radius: 50%;
  }

  .status-marker {
    background: var(--status-color);
    box-shadow: 0 0 0.85rem var(--status-glow);
  }

  .next-marker {
    background: var(--color-purple);
    box-shadow: 0 0 0.85rem rgb(128 32 224 / 34%);
  }

  .stage-track {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    top: 4.95rem;

    height: 0;
  }

  .status-done .stage-track {
    left: 1.55rem;
  }

  .status-done .stage-track::before,
  .status-later .stage-track::before {
    content: '';

    position: absolute;
    left: 0;
    right: 0;
    top: -1px;

    height: 2px;

    background: var(--status-color);
    opacity: 0.72;
  }

  .status-later .stage-track {
    right: 1.55rem;
  }

  .progress-wave {
    position: absolute;
    left: 0;
    right: 0;
    top: -0.9rem;

    width: 100%;
    height: 1.8rem;

    overflow: visible;
  }

  .progress-wave path {
    fill: none;
    stroke: var(--color-yellow);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;

    vector-effect: non-scaling-stroke;

    filter: drop-shadow(0 0 0.35rem rgb(240 240 0 / 24%));
  }

  .stage-node {
    position: absolute;
    z-index: 4;
    top: 0;

    width: 1rem;
    height: 1rem;

    border: 0;
    border-radius: 50%;

    background: var(--status-color);
    box-shadow: 0 0 1rem var(--status-glow);

    transform: translateY(-50%);
  }

  .status-done .stage-node {
    right: -0.5rem;
  }

  .status-active .stage-node {
    left: 62%;

    box-shadow:
      0 0 0 0.28rem rgb(240 240 0 / 12%),
      0 0 1.4rem rgb(240 240 0 / 34%);

    transform: translate(-50%, -50%);
  }

  .status-later .stage-node {
    left: -0.5rem;
  }

  :global([data-theme='light']) .stage-status,
  :global([data-theme='light']) .next-label {
    color: var(--color-text-subtle);
  }


  .roadmap-stage h3 {
    margin: 4.4rem 0 0;

    color: var(--color-text);

    font-size: clamp(1.08rem, 1.45vw, 1.32rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }


  .status-active::after {
    content: '';

    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
      radial-gradient(
        circle at 28% 42%,
        rgb(240 240 0 / 5%),
        transparent 13rem
      ),
      radial-gradient(
        circle at 76% 62%,
        rgb(128 32 224 / 7%),
        transparent 15rem
      );
  }

  .next-milestone {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.1rem;

    margin-top: auto;
    padding-top: 1.2rem;

    border-top: 1px solid var(--color-border);
  }

  .next-milestone strong {
    color: var(--color-text);

    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .roadmap-footer {
    display: flex;
    justify-content: flex-end;

    margin-top: 2.25rem;
  }

  .roadmap-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.78rem;

    text-decoration: none;
  }

  .roadmap-footer a span {
    color: var(--color-purple);

    transition: transform var(--transition-fast);
  }

  .roadmap-footer a:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 980px) {
    .roadmap-track {
      grid-template-columns: 1fr;
    }

    .roadmap-track::before {
      display: none;
    }

    .roadmap-stage {
      min-height: 170px;
    }

    .stage-track {
      position: relative;
      top: auto;
      left: auto;
      right: auto;

      width: 100%;
      height: auto;

      margin-top: 1.65rem;
    }

    .status-done .stage-track::before,
    .status-later .stage-track::before,
    .progress-wave {
      display: none;
    }

    .stage-node,
    .status-done .stage-node,
    .status-active .stage-node,
    .status-later .stage-node {
      position: relative;
      top: auto;
      left: auto;
      right: auto;

      display: block;

      transform: none;
    }

    .roadmap-stage h3 {
      margin-top: 1.6rem;
    }

    .next-milestone {
      margin-top: 1.5rem;
    }
  }

  @media (max-width: 820px) {
    .roadmap-heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .roadmap-heading .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }
  }

  @media (max-width: 560px) {
    .next-milestone {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .roadmap-footer {
      justify-content: flex-start;
    }
  }
</style>
