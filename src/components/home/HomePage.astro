---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from './HomeHero.astro';
import HomeObjective from './HomeObjective.astro';
import HomeApplications from './HomeApplications.astro';
import HomePhysics from './HomePhysics.astro';

import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t('meta.home.title')}
  description={t('meta.home.description')}
>
  <main>
    <HomeHero lang={lang} />
    <HomeObjective lang={lang} />
    <HomeApplications lang={lang} />
    <HomePhysics lang={lang} />
  </main>
</BaseLayout>
