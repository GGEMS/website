---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const applications = [
  {
    title: t('applications.ct.title'),
    body: t('applicationsPage.ct.body'),
    visual: 'CT · CBCT',
    visualClass: 'visual-green',
    reverse: false,
  },
  {
    title: t('applications.pet.title'),
    body: t('applicationsPage.pet.body'),
    visual: 'PET · SPECT',
    visualClass: 'visual-purple',
    reverse: true,
  },
  {
    title: t('applications.dosimetry.title'),
    body: t('applicationsPage.dose.body'),
    visual: t('applications.dosimetry.visual'),
    visualClass: 'visual-yellow',
    reverse: false,
  },
  {
    title: t('applications.therapy.title'),
    body: t('applicationsPage.therapy.body'),
    visual: t('applications.therapy.visual'),
    visualClass: 'visual-mixed',
    reverse: true,
  },
];
---

<BaseLayout
  lang={lang}
  title={t('meta.applications.title')}
  description={t('meta.applications.description')}
>
  <main class="applications-page">
    <section class="page-hero">
      <div class="container hero-grid">
        <p class="eyebrow">{t('applicationsPage.eyebrow')}</p>

        <h1 class="display">
          {t('applicationsPage.hero.primary')}
          <span>{t('applicationsPage.hero.secondary')}</span>
        </h1>

        <p class="lead">
          {t('applicationsPage.hero.lead')}
        </p>
      </div>
    </section>

    <section class="section application-scope">
      <div class="container section-heading">
        <p class="eyebrow">{t('applicationsPage.scope.eyebrow')}</p>

        <h2 class="heading-1">
          {t('applicationsPage.scope.title.primary')}
          <span>{t('applicationsPage.scope.title.secondary')}</span>
        </h2>
      </div>

      <div class="container application-list">
        {
          applications.map((item) => (
            <article class:list={['application', { 'application-reverse': item.reverse }]}>
              <div class="application-copy">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>

              <div class:list={['application-visual', item.visualClass]}>
                <span>{item.visual}</span>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .applications-page {
    --applications-band-a: #07111b;
    --applications-band-b: #0d1b27;
    --applications-section-padding: 4.5rem;
  }

  :global([data-theme='light']) .applications-page {
    --applications-band-a: #f8faf9;
    --applications-band-b: #dce7df;
  }

  .page-hero {
    padding-block: 5.5rem;

    background: var(--applications-band-a);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 4rem;
    row-gap: 1.25rem;
    align-items: start;
  }

  .hero-grid > .eyebrow {
    grid-area: eyebrow;
  }

  .hero-grid > .display {
    grid-area: title;

    max-width: 12ch;
    margin: 0;

    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .hero-grid > .lead {
    grid-area: lead;

    max-width: 30rem;
    margin: 0;

    align-self: start;
  }

  .display span,
  .heading-1 span {
    display: block;

    color: var(--color-text-muted);
    font-weight: 400;
  }

  .application-scope {
    padding-block: var(--applications-section-padding);

    background: var(--applications-band-b);
  }

  .section-heading {
    margin-inline: auto;
  }

  .section-heading .heading-1 {
    max-width: 18ch;
    margin-top: 1.25rem;

    font-size: clamp(2.8rem, 5vw, 5rem);
  }

  .application-list {
    margin-top: 3.5rem;
  }

  .application {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    align-items: center;
    gap: clamp(2rem, 3vw, 3rem);

    padding-block: 2.5rem;
  }

  .application-reverse {
    grid-template-columns: minmax(0, 1.28fr) minmax(280px, 0.72fr);
  }

  .application-reverse .application-copy {
    order: 2;
  }

  .application-reverse .application-visual {
    order: 1;
  }

  .application-copy {
    max-width: 31rem;
  }

  .application h3 {
    margin: 0;

    font-size: clamp(2rem, 3.5vw, 3.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .application-copy > p {
    margin: 1.5rem 0 0;

    color: var(--color-text-muted);

    line-height: 1.75;
  }

  .application-visual {
    position: relative;

    min-height: 320px;

    display: grid;
    place-items: center;

    overflow: hidden;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);

    background: var(--color-surface);
  }

  .application-visual::before,
  .application-visual::after {
    content: '';

    position: absolute;

    border-radius: 50%;
  }

  .application-visual::before {
    width: 17rem;
    height: 17rem;

    border: 1px solid var(--color-visual-line);
  }

  .application-visual::after {
    width: 25rem;
    height: 9rem;

    border: 1px solid var(--color-visual-line-soft);

    transform: rotate(-18deg);
  }

  .application-visual span {
    position: relative;
    z-index: 2;

    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  .visual-green {
    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(80 192 112 / 16%),
        transparent 18rem
      ),
      var(--color-surface);
  }

  .visual-purple {
    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(128 32 224 / 18%),
        transparent 18rem
      ),
      var(--color-surface);
  }

  .visual-yellow {
    background:
      radial-gradient(
        circle at 50% 50%,
        rgb(240 240 0 / 10%),
        transparent 18rem
      ),
      var(--color-surface);
  }

  .visual-mixed {
    background:
      radial-gradient(
        circle at 38% 45%,
        rgb(80 192 112 / 13%),
        transparent 14rem
      ),
      radial-gradient(
        circle at 65% 55%,
        rgb(128 32 224 / 16%),
        transparent 16rem
      ),
      var(--color-surface);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .hero-grid > .display {
      max-width: 12ch;
    }

    .hero-grid > .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }

    .application,
    .application-reverse {
      grid-template-columns: 1fr;
      gap: 2rem;

      padding-block: 2.25rem;
    }

    .application-reverse .application-copy,
    .application-reverse .application-visual {
      order: initial;
    }

    .application-visual {
      min-height: 300px;
    }
  }

  @media (max-width: 720px) {
    .applications-page {
      --applications-section-padding: 4rem;
    }

    .page-hero {
      padding-block: 4.5rem;
    }
  }
</style>
