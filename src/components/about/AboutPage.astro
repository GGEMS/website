---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const identityBody =
  lang === 'fr'
    ? 'GGEMS est développé à la fois comme environnement de simulation autonome et comme fondation logicielle scientifique réutilisable.'
    : 'GGEMS is developed as both a standalone simulation environment and a reusable scientific software foundation.';

const values = [
  {
    title: t('about.values.gpu.title'),
    body: t('about.values.gpu.body'),
  },
  {
    title: t('about.values.science.title'),
    body: t('about.values.science.body'),
  },
  {
    title: t('about.values.open.title'),
    body: t('about.values.open.body'),
  },
];

const people = [
  {
    name: t('about.people.julien'),
    role:
      lang === 'fr'
        ? 'Ingénieur hospitalier · CHU Brest — Hôpital Morvan · Chef de projet & porte-parole'
        : 'Hospital Engineer · CHU Brest — Hôpital Morvan · Project Lead & Spokesperson',
  },
  {
    name: t('about.people.didier'),
    role:
      lang === 'fr'
        ? 'Ingénieur de recherche INSERM · Développeur principal'
        : 'INSERM Research Engineer · Lead Developer',
  },
];
---

<BaseLayout
  lang={lang}
  title={t('meta.about.title')}
  description={t('meta.about.description')}
>
  <main class="about-page">
    <section class="page-hero">
      <div class="container hero-grid">
        <p class="eyebrow">{t('about.eyebrow')}</p>

        <h1 class="display">
          {t('about.hero.primary')}
          <span>{t('about.hero.secondary')}</span>
        </h1>

        <p class="lead">
          {t('about.hero.lead')}
        </p>
      </div>
    </section>

    <section class="section identity">
      <div class="container identity-grid">
        <p class="eyebrow">{t('about.identity.eyebrow')}</p>

        <h2 class="heading-1">
          {t('about.identity.title.primary')}
          <span>{t('about.identity.title.secondary')}</span>
        </h2>

        <p class="lead">
          {identityBody}
        </p>
      </div>

      <div class="container values">
        {
          values.map((item) => (
            <article class="value">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section people-section">
      <div class="container people-grid">
        <p class="eyebrow">{t('about.people.eyebrow')}</p>

        <h2 class="heading-1">
          {t('about.people.title.primary')}
          <span>{t('about.people.title.secondary')}</span>
        </h2>

        <div class="people-list">
          {
            people.map((person) => (
              <article>
                <h3>{person.name}</h3>
                <p>{person.role}</p>
              </article>
            ))
          }

        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-page {
    --about-band-a: #07111b;
    --about-band-b: #0d1b27;
    --about-section-padding: 4.5rem;
  }

  :global([data-theme='light']) .about-page {
    --about-band-a: #f8faf9;
    --about-band-b: #dce7df;
  }

  .page-hero {
    position: relative;

    padding-block: 5.5rem;

    overflow: hidden;

    background: var(--about-band-a);
  }

  .identity,
  .people-section {
    padding-block: var(--about-section-padding);
  }

  .identity {
    background: var(--about-band-b);
  }

  .people-section {
    background: var(--about-band-a);
  }

  .hero-grid,
  .identity-grid,
  .people-grid {
    position: relative;

    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    grid-template-areas:
      'eyebrow .'
      'title side';
    column-gap: 5rem;
    row-gap: 1.25rem;
    align-items: start;
  }

  .hero-grid > .eyebrow,
  .identity-grid > .eyebrow,
  .people-grid > .eyebrow {
    grid-area: eyebrow;
  }

  .hero-grid > .display,
  .identity-grid > .heading-1,
  .people-grid > .heading-1 {
    grid-area: title;
    margin: 0;
  }

  .hero-grid > .lead,
  .identity-grid > .lead,
  .people-grid > .people-list {
    grid-area: side;
    align-self: start;
  }

  .page-hero .display {
    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .identity .heading-1,
  .people-section .heading-1 {
    font-size: clamp(2.8rem, 5vw, 5rem);
  }

  .display span,
  .heading-1 span {
    display: block;

    color: var(--color-text-muted);
    font-weight: 400;
  }

  .hero-grid .lead,
  .identity-grid .lead {
    margin: 0;
  }

  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);

    margin-top: 3.5rem;
  }

  .value {
    min-width: 0;
  }

  .value h3 {
    margin: 0;

    font-size: 1.7rem;
    font-weight: 500;
  }

  .value p {
    max-width: 22rem;

    margin: 1rem 0 0;

    color: var(--color-text-muted);

    line-height: 1.7;
  }

  .people-list {
    border-top: 1px solid var(--color-border);
  }

  .people-list article {
    padding: 1.75rem 0;

    border-bottom: 1px solid var(--color-border);
  }

  .people-list h3 {
    margin: 0;

    font-size: 1.35rem;
    font-weight: 500;
  }

  .people-list p {
    margin: 0.45rem 0 0;

    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .hero-grid,
    .identity-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'side';
      gap: 1.35rem;
    }

    .people-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'side';
      gap: 1.35rem;
    }

    .hero-grid > .lead,
    .identity-grid > .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }

    .people-grid > .people-list {
      margin-top: 1.1rem;
    }

    .values {
      grid-template-columns: 1fr;
    }

    .values {
      gap: 2.5rem;
    }
  }

  @media (max-width: 720px) {
    .about-page {
      --about-section-padding: 4rem;
    }

    .page-hero {
      padding-block: 4.5rem;
    }
  }
</style>
