---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableCompute from '../sections/PortableCompute.astro';
import VisualizationDebugging from '../sections/VisualizationDebugging.astro';

import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';
import { useTechnologyTranslations } from '../../i18n/technology';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tt = useTechnologyTranslations(lang);

const compilers = ['MSVC', 'Intel', 'GNU', 'Clang'];
---

<BaseLayout
  lang={lang}
  title={t('meta.technology.title')}
  description={t('meta.technology.description')}
>
  <main class="technology-page">
    <section class="page-hero">
      <div class="container hero-grid">
        <p class="eyebrow">{t('technologyPage.eyebrow')}</p>

        <h1 class="heading-1">
          {t('technologyPage.hero.primary')}
          <span>{t('technologyPage.hero.secondary')}</span>
        </h1>

        <p class="lead">
          {t('technologyPage.hero.lead')}
        </p>
      </div>
    </section>

    <section class="section modern-core">
      <div class="container core-heading">
        <p class="eyebrow">{tt('core.eyebrow')}</p>

        <h2 class="heading-1">
          {tt('core.title.primary')}
          <span>{tt('core.title.secondary')}</span>
        </h2>

        <p class="lead">
          {tt('core.lead')}
        </p>
      </div>

      <div class="container core-grid">
        <article class="core-block native-block">
          <div>
            <p class="core-kicker">{tt('core.native.toolchains')}</p>
            <h3>{tt('core.native.title')}</h3>
            <p>{tt('core.native.body')}</p>
          </div>

          <div class="compiler-grid" aria-label={tt('core.native.toolchains')}>
            {compilers.map((compiler) => (
              <span>{compiler}</span>
            ))}
          </div>
        </article>

        <article class="core-block python-block">
          <div>
            <p class="core-kicker">{tt('core.python.bridge')}</p>
            <h3>{tt('core.python.title')}</h3>
            <p>{tt('core.python.body')}</p>
          </div>

          <div class="python-bridge" aria-hidden="true">
            <span>C++</span>
            <span class="bridge-arrow">↔</span>
            <span>Python</span>
          </div>
        </article>
      </div>
    </section>

    <PortableCompute lang={lang} />
    <VisualizationDebugging lang={lang} />
  </main>
</BaseLayout>

<style>
  .technology-page {
    --technology-band-a: #07111b;
    --technology-band-b: #0d1b27;
    --technology-section-padding: 4.5rem;
  }

  :global([data-theme='light']) .technology-page {
    --technology-band-a: #f8faf9;
    --technology-band-b: #dce7df;
  }

  .page-hero {
    padding-block: 5.5rem;

    background: var(--technology-band-a);
  }

  .hero-grid,
  .core-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.25rem;
    align-items: start;
  }

  .hero-grid > .eyebrow,
  .core-heading > .eyebrow {
    grid-area: eyebrow;
  }

  .hero-grid > .heading-1,
  .core-heading > .heading-1 {
    grid-area: title;
    margin: 0;
  }

  .hero-grid > .lead,
  .core-heading > .lead {
    grid-area: lead;
    margin: 0;
  }

  .heading-1 span {
    display: block;

    color: var(--color-text-muted);
    font-weight: 400;
  }

  .modern-core,
  :global(.portable-compute),
  :global(.visualization-debugging) {
    padding-block: var(--technology-section-padding);
  }

  .modern-core {
    background: var(--technology-band-b);
  }

  .technology-page :global(.portable-compute) {
    background: var(--technology-band-a);
  }

  .technology-page :global(.visualization-debugging) {
    background: var(--technology-band-b);
  }

  .core-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;

    margin-top: 3.5rem;
  }

  .core-block {
    min-width: 0;
    min-height: 18rem;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;

    padding: 1.75rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    background: rgb(127 127 127 / 2%);
  }

  .core-kicker {
    margin: 0;

    color: var(--color-green-light);

    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .core-block h3 {
    margin: 1rem 0 0;

    font-size: 1.65rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .core-block > div > p:last-child {
    max-width: 36rem;
    margin: 1rem 0 0;

    color: var(--color-text-muted);

    line-height: 1.7;
  }

  .compiler-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .compiler-grid span,
  .python-bridge span:not(.bridge-arrow) {
    min-height: 3.25rem;

    display: grid;
    place-items: center;

    padding-inline: 0.8rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);

    color: var(--color-text);
    background: var(--color-control-bg);

    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .python-bridge {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .bridge-arrow {
    color: var(--color-purple);

    font-family: var(--font-mono);
    font-size: 1.15rem;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .core-heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .hero-grid > .lead,
    .core-heading > .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }

    .core-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .technology-page {
      --technology-section-padding: 4rem;
    }

    .page-hero {
      padding-block: 4.5rem;
    }

    .compiler-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
