---
import { type Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n';
import { usePhysicsDetailsTranslations } from '../../i18n/physicsDetails';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = usePhysicsDetailsTranslations(lang);

const particleFamilies = [
  {
    symbols: [
      { symbol: 'γ', type: 'gamma' },
    ],
    title: t('homePhysics.gamma'),
    body: t('physics.gamma.body'),
    processes: t('physics.gamma.processes'),
  },
  {
    symbols: [
      { symbol: 'β−', type: 'electron' },
      { symbol: 'β+', type: 'positron' },
    ],
    stacked: true,
    title: lang === 'fr' ? 'Électron & Positon' : 'Electron & Positron',
    body: t('physics.electrons.body'),
    processes: t('physics.electrons.processes'),
  },
  {
    symbols: [
      { symbol: 'p', type: 'proton' },
    ],
    title: t('homePhysics.proton'),
    body: t('physics.proton.body'),
    processes: t('physics.proton.processes'),
  },
  {
    symbols: [
      { symbol: 'n', type: 'neutron' },
    ],
    title: t('homePhysics.neutron'),
    body: t('physics.neutron.body'),
    processes: t('physics.neutron.processes'),
  },
  {
    symbols: [
      { symbol: 'α', type: 'alpha' },
    ],
    title: 'Alpha & Generic Ion',
    body: t('physics.alpha.body'),
    processes: t('physics.alpha.processes'),
  },
];
---

<BaseLayout
  lang={lang}
  title={t('meta.physics.title')}
  description={t('meta.physics.description')}
>
  <main class="physics-page">
    <section class="physics-hero">
      <div class="container split-heading">
        <p class="eyebrow">{t('physics.eyebrow')}</p>

        <h1 class="heading-1">
          {t('physics.hero.primary')}
          <span>{t('physics.hero.secondary')}</span>
        </h1>

        <p class="lead">
          {t('physics.hero.lead')}
        </p>
      </div>
    </section>

    <section class="section particle-scope">
      <div class="container split-heading particle-intro">
        <p class="eyebrow">{tp('particles.eyebrow')}</p>
        <h2 class="heading-1">{tp('particles.title')}</h2>
        <p class="lead">{tp('particles.lead')}</p>
      </div>

      <div class="particle-bands">
        {
          particleFamilies.map((family, index) => (
            <article class:list={['particle-band', { alternate: index % 2 === 1 }]}>
              <div class="container particle-band-grid">
                <div class="particle-identity">
                  <div class:list={['orb-row', { 'orb-row-stacked': family.stacked }]} aria-hidden="true">
                    {family.symbols.map((particle) => (
                      <div class={`particle-orb ${particle.type}`}>
                        <span>{particle.symbol}</span>
                      </div>
                    ))}
                  </div>

                  <h3>{family.title}</h3>
                </div>

                <div class="particle-description">
                  <p>{family.body}</p>
                </div>

                <div class="particle-processes">
                  <small>{tp('particles.processes')}</small>
                  <p>{family.processes}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section source-radionuclide">
      <div class="container split-heading">
        <p class="eyebrow">{tp('sources.eyebrow')}</p>

        <h2 class="heading-1">
          {tp('sources.title.primary')}
          <span>{tp('sources.title.secondary')}</span>
        </h2>

        <p class="lead">{tp('sources.lead')}</p>
      </div>

      <div class="container source-grid">
        <article class="source-card">
          <p class="card-kicker">SOURCE</p>
          <h3>{tp('sources.source.title')}</h3>
          <p>{tp('sources.source.body')}</p>

          <div class="source-axis" aria-hidden="true">
            <span>SPACE</span>
            <span>ANGLE</span>
            <span>ENERGY</span>
            <span>TIME</span>
          </div>
        </article>

        <article class="source-card">
          <p class="card-kicker">{tp('sources.references')}</p>
          <h3>{tp('sources.radionuclide.title')}</h3>
          <p>{tp('sources.radionuclide.body')}</p>

          <div class="reference-row" aria-label={tp('sources.references')}>
            <a href="http://www.lnhb.fr/" target="_blank" rel="noreferrer">
              <span>LNHB</span>
              <small>↗</small>
            </a>

            <a href="https://mirdsoft.org/" target="_blank" rel="noreferrer">
              <span>MIRDsoft</span>
              <small>↗</small>
            </a>
          </div>
        </article>
      </div>
    </section>

    <section class="section docs-handoff">
      <div class="container split-heading docs-grid">
        <p class="eyebrow">{t('physics.docs.eyebrow')}</p>

        <h2 class="heading-1">
          {t('physics.docs.title.primary')}
          <span>{t('physics.docs.title.secondary')}</span>
        </h2>

        <div class="docs-copy">
          <p class="lead">
            {t('physics.docs.body')}
          </p>

          <a href="https://docs.ggems-project.com/">
            {t('physics.docs.link')}
            <span>↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .physics-page {
    --physics-band-a: #07111b;
    --physics-band-b: #0d1b27;
    --physics-section-padding: 4.5rem;
  }

  :global([data-theme='light']) .physics-page {
    --physics-band-a: #f8faf9;
    --physics-band-b: #dce7df;
  }

  .physics-hero {
    padding-block: 5.5rem;
    background: var(--physics-band-a);
  }

  .particle-scope,
  .source-radionuclide,
  .docs-handoff {
    padding-block: var(--physics-section-padding);
  }

  .particle-scope {
    padding-bottom: 0;
    background: var(--physics-band-b);
  }

  .source-radionuclide {
    background: var(--physics-band-a);
  }

  .docs-handoff {
    background: var(--physics-band-b);
  }

  .split-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.25rem;
    align-items: start;
  }

  .split-heading > .eyebrow {
    grid-area: eyebrow;
  }

  .split-heading > .heading-1 {
    grid-area: title;
    margin: 0;
  }

  .split-heading > .lead,
  .docs-copy {
    grid-area: lead;
    margin: 0;
  }

  .heading-1 span {
    display: block;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .particle-intro {
    padding-bottom: 3.5rem;
  }

  .particle-bands {
    margin-top: 0.5rem;
  }

  .particle-band {
    border-top: 1px solid var(--color-border);
  }

  .particle-band.alternate {
    background: rgb(127 127 127 / 2%);
  }

  .particle-band-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(300px, 1fr) minmax(250px, 0.75fr);
    align-items: center;
    gap: 3rem;

    padding-block: 2.4rem;
  }

  .particle-identity {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }

  .orb-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex: 0 0 auto;
  }

  .orb-row-stacked {
    flex-direction: column;
    gap: 0.35rem;
  }

  .particle-orb {
    --particle-rgb: 192 192 192;

    position: relative;
    width: 4.6rem;
    aspect-ratio: 1;

    display: grid;
    place-items: center;

    overflow: hidden;
    border-radius: 50%;

    background:
      radial-gradient(
        circle at 30% 24%,
        rgb(255 255 255 / 82%) 0%,
        rgb(255 255 255 / 30%) 9%,
        transparent 25%
      ),
      radial-gradient(
        circle at 70% 76%,
        rgb(0 0 0 / 24%) 0%,
        transparent 48%
      ),
      radial-gradient(
        circle at 42% 38%,
        rgb(var(--particle-rgb) / 78%) 0%,
        rgb(var(--particle-rgb) / 48%) 52%,
        rgb(var(--particle-rgb) / 22%) 78%,
        rgb(var(--particle-rgb) / 10%) 100%
      );

    box-shadow:
      inset 0.55rem 0.55rem 1.2rem rgb(255 255 255 / 18%),
      inset -0.65rem -0.75rem 1.5rem rgb(0 0 0 / 20%),
      0 0.55rem 1.2rem rgb(0 0 0 / 10%),
      0 0 1.6rem rgb(var(--particle-rgb) / 8%);
  }

  .particle-orb.gamma { --particle-rgb: 46 139 87; }
  .particle-orb.electron { --particle-rgb: 58 178 190; }
  .particle-orb.positron { --particle-rgb: 255 160 255; }
  .particle-orb.proton { --particle-rgb: 220 20 60; }
  .particle-orb.neutron { --particle-rgb: 192 192 192; }
  .particle-orb.alpha { --particle-rgb: 255 255 80; }

  .particle-orb span {
    position: relative;
    z-index: 1;

    color: var(--color-text);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .particle-orb.electron span,
  .particle-orb.positron span {
    font-size: 1.95rem;
  }

  :global([data-theme='light']) .particle-orb {
    box-shadow:
      inset 0.6rem 0.6rem 1.2rem rgb(255 255 255 / 46%),
      inset -0.7rem -0.85rem 1.55rem rgb(0 0 0 / 24%),
      0 0.55rem 1.2rem rgb(22 34 28 / 15%),
      0 0 1.7rem rgb(var(--particle-rgb) / 13%);
  }

  .particle-identity h3 {
    margin: 0;

    font-size: clamp(1.7rem, 2.5vw, 2.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .particle-description p,
  .particle-processes p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .particle-processes small {
    display: block;
    margin-bottom: 0.8rem;

    color: var(--color-green-light);

    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .particle-processes p {
    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .source-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;

    margin-top: 3.5rem;
  }

  .source-card {
    min-height: 19rem;

    display: flex;
    flex-direction: column;

    padding: 1.75rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    background: rgb(127 127 127 / 2%);
  }

  .card-kicker {
    margin: 0;

    color: var(--color-green-light);

    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .source-card h3 {
    margin: 1rem 0 0;

    font-size: 1.65rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .source-card > p:not(.card-kicker) {
    max-width: 36rem;
    margin: 1rem 0 0;

    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .source-axis,
  .reference-row {
    display: grid;
    gap: 0.7rem;

    margin-top: auto;
    padding-top: 2rem;
  }

  .source-axis {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .reference-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .source-axis span,
  .reference-row a {
    min-height: 3.2rem;

    display: grid;
    place-items: center;

    padding-inline: 0.8rem;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);

    color: var(--color-text);
    background: var(--color-control-bg);

    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-decoration: none;
  }

  .reference-row a {
    grid-template-columns: 1fr auto;
    gap: 0.75rem;

    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      transform var(--transition-fast);
  }

  .reference-row a:hover {
    border-color: var(--color-border-strong);
    background: var(--color-control-hover);
    transform: translateY(-2px);
  }

  .reference-row a span {
    justify-self: center;
  }

  .reference-row a small {
    color: var(--color-purple);
    font-size: 0.72rem;
  }

  .docs-copy .lead {
    margin: 0;
  }

  .docs-copy a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    margin-top: 2rem;

    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-decoration: none;
  }

  .docs-copy a span {
    color: var(--color-purple);
    transition: transform var(--transition-fast);
  }

  .docs-copy a:hover span {
    transform: translate(2px, -2px);
  }

  @media (max-width: 980px) {
    .split-heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .split-heading > .lead,
    .docs-copy {
      max-width: 44rem;
      margin-top: 1.1rem;
    }

    .particle-band-grid {
      grid-template-columns: minmax(200px, 0.8fr) minmax(0, 1.2fr);
      gap: 2rem;
    }

    .particle-processes {
      grid-column: 2;
    }
  }

  @media (max-width: 720px) {
    .physics-page {
      --physics-section-padding: 4rem;
    }

    .physics-hero {
      padding-block: 4.5rem;
    }

    .particle-band-grid,
    .source-grid {
      grid-template-columns: 1fr;
    }

    .particle-processes {
      grid-column: auto;
    }

    .source-axis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
