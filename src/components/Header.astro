---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localizedPath, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n';

interface Props {
  lang: Lang;
  showLanguageSwitcher?: boolean;
}

const {
  lang,
  showLanguageSwitcher = true,
} = Astro.props;

const t = useTranslations(lang);

const navigation = [
  { label: t('nav.about'), href: localizedPath('/about/', lang) },
  { label: t('nav.applications'), href: localizedPath('/applications/', lang) },
  { label: t('nav.physics'), href: localizedPath('/physics/', lang) },
  { label: t('nav.technology'), href: localizedPath('/technology/', lang) },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a
      class="brand"
      href={localizedPath('/', lang)}
      aria-label="GGEMS home"
    >
      <img src="/images/ggems-logo.png" alt="" />

      <span class="brand-copy">
        <strong>GGEMS</strong>
        <small>GPU Geant4-based Monte Carlo Simulations</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {
        navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }

      <a
        href="https://docs.ggems-project.com/"
        class="external"
      >
        {t('nav.documentation')}
      </a>

      <a
        href="https://forum.ggems-project.com/"
        class="external"
      >
        {t('nav.community')}
      </a>
    </nav>

    {showLanguageSwitcher && <LanguageSwitcher lang={lang} />}

    <ThemeToggle />

    <a
      class="github-link"
      href="https://github.com/GGEMS/ggems"
      aria-label="GGEMS on GitHub"
    >
      {t('nav.github')}
      <span>↗</span>
    </a>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
      </summary>

      <nav>
        {
          navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }

        <a href="https://docs.ggems-project.com/">{t('nav.documentation')} ↗</a>
        <a href="https://forum.ggems-project.com/">{t('nav.community')} ↗</a>
        <a href="https://github.com/GGEMS/ggems">{t('nav.github')} ↗</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');

  if (header instanceof HTMLElement) {
    let ticking = false;

    const updateHeader = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
      ticking = false;
    };

    const requestHeaderUpdate = () => {
      if (ticking) return;

      ticking = true;
      window.requestAnimationFrame(updateHeader);
    };

    updateHeader();
    window.addEventListener('scroll', requestHeaderUpdate, { passive: true });
  }
</script>

<style>
  .site-header {
    --header-background: rgb(7 17 27 / 72%);
    --header-background-scrolled: rgb(7 17 27 / 94%);

    position: sticky;
    top: 0;
    z-index: 100;

    border-bottom: 1px solid var(--color-border);

    background: var(--header-background);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  :global([data-theme='light']) .site-header {
    --header-background: rgb(244 247 245 / 76%);
    --header-background-scrolled: rgb(244 247 245 / 95%);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-border-strong);

    background: var(--header-background-scrolled);

    box-shadow: 0 0.65rem 2rem rgb(0 0 0 / 10%);
  }

  :global([data-theme='light']) .site-header.is-scrolled {
    box-shadow: 0 0.65rem 2rem rgb(22 34 28 / 7%);
  }

  .header-inner {
    height: 5.25rem;

    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;

    margin-right: auto;

    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;

    text-decoration: none;
  }

  .brand img {
    width: 2.5rem;
    height: 2.5rem;

    object-fit: contain;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .brand-copy strong {
    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.08em;
  }

  .brand-copy small {
    color: var(--color-text-subtle);

    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .desktop-nav a,
  .github-link {
    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.82rem;

    text-decoration: none;

    transition: color var(--transition-fast);
  }

  .desktop-nav a:hover,
  .github-link:hover {
    color: var(--color-text);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;

    padding-left: 1rem;

    border-left: 1px solid var(--color-border);
  }

  .github-link span {
    color: var(--color-purple);
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 1120px) {
    .desktop-nav,
    .github-link {
      display: none;
    }

    .mobile-nav {
      position: relative;

      display: block;
    }

    .mobile-nav summary {
      width: 2.8rem;
      height: 2.8rem;

      display: grid;
      align-content: center;
      gap: 0.4rem;

      cursor: pointer;
      list-style: none;
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav summary span {
      display: block;

      width: 1.5rem;
      height: 1px;
      margin-left: auto;

      background: var(--color-text);
    }

    .mobile-nav nav {
      position: absolute;
      right: 0;
      top: 3.4rem;

      width: min(19rem, calc(100vw - 2rem));

      display: flex;
      flex-direction: column;

      padding: 0.75rem;

      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);

      background: var(--color-surface-raised);

      box-shadow: 0 1.5rem 4rem var(--color-shadow);
    }

    .mobile-nav nav a {
      padding: 0.9rem 1rem;

      color: var(--color-text-muted);

      border-radius: var(--radius-sm);

      font-family: var(--font-mono);
      font-size: 0.78rem;

      text-decoration: none;
    }

    .mobile-nav nav a:hover {
      color: var(--color-text);

      background: var(--color-control-hover);
    }
  }

  @media (max-width: 720px) {
    .brand-copy small {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>
