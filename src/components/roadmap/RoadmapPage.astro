---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sections = [
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Core rebuild',
    description:
      'A modern GPU-first software foundation for the new GGEMS implementation.',
    groups: [
      {
        title: 'Core',
        items: [
          'Modern C++ architecture',
          'Project structure',
          'OpenCL foundation',
          'GPU-first execution model',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Source system',
    description:
      'A dedicated source subsystem for controlled and reproducible particle generation.',
    groups: [
      {
        title: 'Sampling',
        items: [
          'General source sampling',
          'Geometry / angle / energy / time',
          'Random / reproducibility foundations',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Radionuclides',
    description:
      'Activity-driven source workflows and a medical radionuclide foundation.',
    groups: [
      {
        title: 'Radionuclide sources',
        items: [
          'Activity-driven sources',
          'Medical radionuclide catalog',
          'LNHB / MIRDsoft data foundations',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Testing & validation framework',
    description:
      'A reproducible validation workflow accompanies implementation from the beginning.',
    groups: [
      {
        title: 'Validation infrastructure',
        items: [
          'C++ unit tests',
          'Python validation tools',
          'Campaign automation',
          'Reference datasets',
          'Statistical validation foundations',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Materials & Cuts',
    description:
      'Material definition and production-cut foundations for the first physical transport chain.',
    groups: [
      {
        title: 'Materials',
        items: [
          'Isotopic materials',
          'Material identity / compilation',
        ],
      },
      {
        title: 'Production Cuts',
        items: [
          'Production Cuts',
          'Material / Cut couples',
        ],
      },
    ],
  },
  {
    status: 'complete',
    eyebrow: 'Completed',
    title: 'Software / UI / doc cleanup',
    description:
      'The software surface and developer-facing tools were consolidated before physical implementation continues.',
    groups: [
      {
        title: 'Software & UI',
        items: [
          'Renderer / Vulkan / ImGui restructuring',
          'Public API cleanup',
        ],
      },
      {
        title: 'Documentation',
        items: [
          'Doxygen cleanup',
          'Website / documentation foundations',
        ],
      },
    ],
  },
  {
    status: 'current',
    eyebrow: 'In progress',
    title: 'Navigation',
    description:
      'Current implementation work focuses on the first bounded geometry slice.',
    groups: [
      {
        title: 'Geometry scope',
        items: [
          'Finite World',
          'Analytic Box',
          'Initial bounded navigation',
        ],
      },
      {
        title: 'Later extensions',
        items: [
          'Voxels',
          'Mesh-based geometries',
          'More complex navigation cases',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Physical Processes',
    description:
      'Physics is implemented and validated by particle family, starting from the first medically relevant transport chains.',
    groups: [
      {
        title: 'Gamma',
        items: [
          'Compton scattering',
          'Rayleigh scattering',
          'Photoelectric effect',
          'Pair production',
          'Atomic relaxation',
        ],
      },
      {
        title: 'Electron / Positron',
        items: [
          'Ionization',
          'Bremsstrahlung',
          'Annihilation',
          'Multiple scattering',
          'Stopping / range',
        ],
      },
      {
        title: 'Proton / Alpha',
        items: [
          'Stopping',
          'Ionization',
          'Multiple scattering',
          'NIEL',
        ],
      },
      {
        title: 'Neutron',
        items: [
          'Evaluated nuclear data',
          'Elastic / inelastic / capture',
          'Thermal treatment / HP-HPT',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Transport',
    description:
      'Transport connects geometry and physical processes into complete particle histories.',
    groups: [
      {
        title: 'First transport chain',
        items: [
          'Process / geometry competition',
          'Physical step',
          'Secondary production',
          'Time of flight',
          'Field-free transport',
        ],
      },
      {
        title: 'Later transport scope',
        items: [
          'Charged-particle transport extensions',
          'Multiple-scattering integration',
          'Magnetic-field support',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Scoring',
    description:
      'Accepted particle transport becomes measurable scientific output.',
    groups: [
      {
        title: 'Scientific quantities',
        items: [
          'Energy deposition',
          'Dose',
          'Photon TLE',
          'History statistics',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Detector & Acquisition',
    description:
      'The detector chain transforms physical interactions into acquisition-level data products.',
    groups: [
      {
        title: 'Sensitive detector',
        items: [
          'Detector elements',
          'Raw Hits',
        ],
      },
      {
        title: 'Digitizer',
        items: [
          'Detector response',
          'Energy and timing response',
          'Efficiency and thresholds',
          'Energy windows',
          'Dead time',
        ],
      },
      {
        title: 'Acquisition',
        items: [
          'Scanner states',
          'Motion',
          'Exposures and projections',
          'Temporal acquisition logic',
        ],
      },
      {
        title: 'Detector data',
        items: [
          'Singles',
          'Coincidences',
          'PET / SPECT products',
          'CT / CBCT products',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Scientific I/O & Reconstruction',
    description:
      'Committed GGEMS scientific products are exposed through explicit data formats and reconstruction-oriented interoperability.',
    groups: [
      {
        title: 'Scientific I/O',
        items: [
          'MHD',
          '...',
        ],
      },
      {
        title: 'Reconstruction ecosystem',
        items: [
          'STIR',
          'CASToR',
          '...',
        ],
      },
    ],
  },
  {
    status: 'future',
    eyebrow: 'Planned',
    title: 'Integration, Validation & Performance',
    description:
      'Complete workflows are qualified only after their scientific components and cross-domain behavior are established.',
    groups: [
      {
        title: 'Integration',
        items: [
          'Named modalities',
          'Multi-device',
          'Reproducibility',
        ],
      },
      {
        title: 'Qualification',
        items: [
          'Scientific validation',
          'Performance characterization',
          'Optimization without changing the science',
        ],
      },
    ],
  },
]
---

<BaseLayout
  lang="en"
  localized={false}
  title="Roadmap — GGEMS"
  description="Follow the GGEMS development roadmap toward the first public release."
>
  <main class="roadmap-page">
    <section class="roadmap-hero">
      <div class="container hero-grid">
        <p class="eyebrow">Roadmap</p>

        <h1 class="heading-1">
          From validated foundations
          <span>to the GGEMS release.</span>
        </h1>

        <p class="lead">
          GGEMS is built incrementally: each domain is developed on top of
          validated foundations, integrated only when its upstream behavior is
          ready, and organized toward a public scientific release.
        </p>
      </div>
    </section>

    <section class="roadmap-flow">
      <div class="container flow-shell">
        <div class="roadmap-arrow" aria-hidden="true">
          <span class="arrow-line"></span>
          <span class="arrow-head"></span>
        </div>

        <div class="roadmap-sections">
          <article class="start-section">
            <div class="start-card">
              <h2>GGEMS 2.0 Begins</h2>
              <p>October 2025</p>
            </div>
          </article>

          {
            sections.map((section) => (
              <article class:list={['roadmap-section', `status-${section.status}`]}>
                <div class="section-content">
                  <header class="section-heading">
                    <div>
                      <p class="section-status">{section.eyebrow}</p>
                      <h2>{section.title}</h2>
                    </div>

                    <p>{section.description}</p>
                  </header>

                  {
                    section.groups.length > 0 && (
                      <div class:list={['group-grid', `groups-${Math.min(section.groups.length, 4)}`]}>
                        {
                          section.groups.map((group) => (
                            <section class="roadmap-group">
                              <h3>{group.title}</h3>

                              <ul>
                                {group.items.map((item) => <li>{item}</li>)}
                              </ul>
                            </section>
                          ))
                        }
                      </div>
                    )
                  }
                </div>
              </article>
            ))
          }

          <article class="release-section">
            <div class="release-card">
              <h2>GGEMS Release</h2>
              <p class="release-date">1st semester 2027</p>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .roadmap-page {
    --roadmap-band-a: #07111b;
    --roadmap-band-b: #0d1b27;
    --roadmap-line: rgb(114 128 142 / 34%);
  }

  :global([data-theme='light']) .roadmap-page {
    --roadmap-band-a: #f8faf9;
    --roadmap-band-b: #dce7df;
    --roadmap-line: rgb(22 34 28 / 20%);
  }

  .roadmap-hero {
    padding-block: 5.5rem;
    background: var(--roadmap-band-a);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.25rem;
    align-items: start;
  }

  .hero-grid > .eyebrow {
    grid-area: eyebrow;
  }

  .hero-grid > .heading-1 {
    grid-area: title;
    margin: 0;
  }

  .hero-grid > .lead {
    grid-area: lead;
    margin: 0;
  }

  .hero-grid .heading-1 span {
    display: block;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .roadmap-flow {
    position: relative;
    background: var(--roadmap-band-b);
  }

  .flow-shell {
    position: relative;
    padding-block: 5rem 8rem;
  }

  .roadmap-arrow {
    position: absolute;
    top: 5rem;
    bottom: 5.5rem;
    left: 2.2rem;
    width: 1.6rem;
    pointer-events: none;
  }

  .arrow-line {
    position: absolute;
    top: 0;
    bottom: 1.1rem;
    left: 50%;
    width: 3px;
    background:
      linear-gradient(
        180deg,
        var(--color-green) 0%,
        var(--color-green) 43%,
        rgb(150 214 75) 47%,
        var(--color-yellow) 50%,
        rgb(171 176 68) 55%,
        var(--roadmap-line) 60%,
        var(--roadmap-line) 88%,
        rgb(96 58 154) 94%,
        var(--color-purple) 100%
      );
    transform: translateX(-50%);
  }

  .arrow-head {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 0;
    border-left: 0.55rem solid transparent;
    border-right: 0.55rem solid transparent;
    border-top: 0.95rem solid var(--color-purple);
    transform: translateX(-50%);
  }

  .roadmap-sections {
    display: grid;
    gap: 1.5rem;
    padding-left: 6.2rem;
  }

  .roadmap-section {
    position: relative;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgb(127 127 127 / 2%);
  }

  .roadmap-section.status-complete {
    border-color: rgb(80 192 112 / 28%);
    background:
      linear-gradient(145deg, rgb(80 192 112 / 7%), transparent 45%),
      rgb(127 127 127 / 2%);
  }

  .roadmap-section.status-current {
    border-color: rgb(240 240 0 / 30%);
    background:
      linear-gradient(145deg, rgb(240 240 0 / 6%), transparent 45%),
      rgb(127 127 127 / 2%);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(280px, 1.15fr);
    gap: 3rem;
    align-items: start;
  }

  .section-status {
    margin: 0 0 0.7rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .status-complete .section-status {
    color: var(--color-green-light);
  }

  .status-current .section-status {
    color: var(--color-yellow);
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .section-heading > p {
    max-width: 46rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .group-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .groups-1 {
    grid-template-columns: 1fr;
  }

  .groups-1 .roadmap-group ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    row-gap: 0.55rem;
  }

  .groups-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .groups-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .groups-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .roadmap-group {
    min-width: 0;
    padding: 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-control-bg);
  }

  .roadmap-group h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .roadmap-group ul {
    display: grid;
    gap: 0.55rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-group li {
    position: relative;
    padding-left: 1rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .roadmap-group li::before {
    content: '';
    position: absolute;
    top: 0.66em;
    left: 0;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: var(--color-text-subtle);
  }

  .status-complete .roadmap-group li::before {
    background: var(--color-green);
  }

  .status-current .roadmap-group li::before {
    background: var(--color-yellow);
  }

  .start-section {
    padding-bottom: 0;
  }

  .start-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;

    padding: 2rem 2.5rem;

    border: 1px solid rgb(80 192 112 / 38%);
    border-radius: var(--radius-lg);

    background:
      radial-gradient(circle at 85% 30%, rgb(80 192 112 / 14%), transparent 24rem),
      var(--roadmap-band-a);

    text-align: center;
  }

  .start-card h2 {
    width: 100%;
    margin: 0;

    text-align: center;
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .start-card p {
    width: 100%;
    margin: 0;

    text-align: center;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .release-section {
    padding-top: 1.5rem;
  }

  .release-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;

    padding: 2rem 2.5rem;

    border: 1px solid rgb(128 32 224 / 38%);
    border-radius: var(--radius-lg);

    background:
      radial-gradient(circle at 85% 30%, rgb(128 32 224 / 14%), transparent 24rem),
      var(--roadmap-band-a);

    text-align: center;
  }

  .release-card h2 {
    width: 100%;
    margin: 0;

    text-align: center;
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .release-date {
    width: 100%;
    margin: 0;

    text-align: center;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 1040px) {
    .groups-4,
    .groups-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .hero-grid > .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }

    .roadmap-arrow {
      left: 1.25rem;
    }

    .roadmap-sections {
      padding-left: 4.4rem;
    }

    .section-heading {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 620px) {
    .roadmap-hero {
      padding-block: 4.5rem;
    }

    .flow-shell {
      padding-block: 4rem 6rem;
    }

    .roadmap-arrow {
      left: 0.7rem;
    }

    .roadmap-sections {
      padding-left: 2.7rem;
    }

    .groups-2,
    .groups-3,
    .groups-4 {
      grid-template-columns: 1fr;
    }

    .groups-1 .roadmap-group ul {
      grid-template-columns: 1fr;
    }

    .roadmap-section {
      padding: 1.35rem;
    }
  }
</style>
