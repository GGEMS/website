---
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<span class="flag" aria-hidden="true">
  {
    lang === 'en' && (
      <svg viewBox="0 0 28 20" role="presentation">
        <rect width="28" height="20" fill="#fff" />
        <g fill="#b22234">
          <rect y="0" width="28" height="1.54" />
          <rect y="3.08" width="28" height="1.54" />
          <rect y="6.16" width="28" height="1.54" />
          <rect y="9.24" width="28" height="1.54" />
          <rect y="12.32" width="28" height="1.54" />
          <rect y="15.40" width="28" height="1.54" />
          <rect y="18.46" width="28" height="1.54" />
        </g>
        <rect width="11.8" height="10.77" fill="#3c3b6e" />
        <g fill="#fff">
          <circle cx="1.5" cy="1.45" r=".38" />
          <circle cx="3.6" cy="1.45" r=".38" />
          <circle cx="5.7" cy="1.45" r=".38" />
          <circle cx="7.8" cy="1.45" r=".38" />
          <circle cx="9.9" cy="1.45" r=".38" />
          <circle cx="2.55" cy="3.1" r=".38" />
          <circle cx="4.65" cy="3.1" r=".38" />
          <circle cx="6.75" cy="3.1" r=".38" />
          <circle cx="8.85" cy="3.1" r=".38" />
          <circle cx="1.5" cy="4.75" r=".38" />
          <circle cx="3.6" cy="4.75" r=".38" />
          <circle cx="5.7" cy="4.75" r=".38" />
          <circle cx="7.8" cy="4.75" r=".38" />
          <circle cx="9.9" cy="4.75" r=".38" />
          <circle cx="2.55" cy="6.4" r=".38" />
          <circle cx="4.65" cy="6.4" r=".38" />
          <circle cx="6.75" cy="6.4" r=".38" />
          <circle cx="8.85" cy="6.4" r=".38" />
          <circle cx="1.5" cy="8.05" r=".38" />
          <circle cx="3.6" cy="8.05" r=".38" />
          <circle cx="5.7" cy="8.05" r=".38" />
          <circle cx="7.8" cy="8.05" r=".38" />
          <circle cx="9.9" cy="8.05" r=".38" />
          <circle cx="2.55" cy="9.7" r=".38" />
          <circle cx="4.65" cy="9.7" r=".38" />
          <circle cx="6.75" cy="9.7" r=".38" />
          <circle cx="8.85" cy="9.7" r=".38" />
        </g>
      </svg>
    )
  }

  {
    lang === 'fr' && (
      <svg viewBox="0 0 28 20" role="presentation">
        <rect width="9.34" height="20" x="0" fill="#0055a4" />
        <rect width="9.34" height="20" x="9.33" fill="#fff" />
        <rect width="9.34" height="20" x="18.66" fill="#ef4135" />
      </svg>
    )
  }
</span>

<style>
  .flag {
    width: 1.35rem;
    aspect-ratio: 7 / 5;

    display: inline-grid;

    flex: 0 0 auto;

    overflow: hidden;

    border: 1px solid var(--color-border-strong);
    border-radius: 0.18rem;

    box-shadow: 0 1px 2px var(--color-shadow);
  }

  .flag svg {
    width: 100%;
    height: 100%;

    display: block;
  }
</style>
