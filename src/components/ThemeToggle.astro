<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch color theme"
  title="Switch color theme"
>
  <span class="theme-icon" data-theme-icon="sun" aria-hidden="true">
    <svg viewBox="0 0 24 24" role="presentation">
      <circle cx="12" cy="12" r="3.5"></circle>
      <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.28 5.28l1.42 1.42M17.3 17.3l1.42 1.42M18.72 5.28 17.3 6.7M6.7 17.3l-1.42 1.42"></path>
    </svg>
  </span>

  <span class="theme-icon" data-theme-icon="moon" aria-hidden="true" hidden>
    <svg viewBox="0 0 24 24" role="presentation">
      <path d="M20 15.3A8.4 8.4 0 0 1 8.7 4a8.4 8.4 0 1 0 11.3 11.3Z"></path>
    </svg>
  </span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (button) {
    const root = document.documentElement;
    const sun = button.querySelector<HTMLElement>('[data-theme-icon="sun"]');
    const moon = button.querySelector<HTMLElement>('[data-theme-icon="moon"]');

    const updateButton = () => {
      const theme = root.dataset.theme === 'light' ? 'light' : 'dark';
      const isDark = theme === 'dark';

      if (sun) sun.hidden = !isDark;
      if (moon) moon.hidden = isDark;

      const target = isDark ? 'light' : 'dark';
      button.setAttribute('aria-label', `Switch to ${target} theme`);
      button.setAttribute('title', `Switch to ${target} theme`);
    };

    button.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';

      root.dataset.theme = nextTheme;

      try {
        localStorage.setItem('ggems-theme', nextTheme);
      } catch {
        // Theme switching still works if storage is unavailable.
      }

      updateButton();
    });

    updateButton();
  }
</script>

<style>
  .theme-toggle {
    width: 2.65rem;
    height: 2.65rem;

    display: grid;
    place-items: center;

    flex: 0 0 auto;

    padding: 0;

    color: var(--color-text-muted);

    border: 1px solid var(--color-border);
    border-radius: 50%;

    background: var(--color-control-bg);

    cursor: pointer;

    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast),
      transform var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--color-text);

    border-color: var(--color-border-strong);

    background: var(--color-control-hover);

    transform: translateY(-1px);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-green-light);
    outline-offset: 3px;
  }

  .theme-icon {
    width: 1.1rem;
    height: 1.1rem;

    display: grid;
    place-items: center;
  }

  .theme-icon[hidden] {
    display: none;
  }

  .theme-icon svg {
    width: 100%;
    height: 100%;

    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }
</style>
