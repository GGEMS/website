---
import type { Lang } from '../../i18n/config';
import { useCapabilityTranslations } from '../../i18n/capabilities';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useCapabilityTranslations(lang);

const placeholderTitle =
  lang === 'fr' ? 'Capture d’interface à venir' : 'Interface capture coming soon';
const placeholderBody =
  lang === 'fr'
    ? 'Une vraie capture de l’interface GGEMS remplacera ce placeholder.'
    : 'A real GGEMS interface capture will replace this placeholder.';
---

<section class="section visualization-debugging">
  <div class="container">
    <div class="visual-heading">
      <p class="eyebrow">{t('visual.eyebrow')}</p>
      <h2 class="heading-1">{t('visual.title')}</h2>
      <p class="lead">{t('visual.lead')}</p>
    </div>

  </div>
</section>

<style>
  .visualization-debugging {
    position: relative;
    overflow: hidden;
  }

  .visual-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.35rem;
    align-items: start;
  }

  .visual-heading > .eyebrow {
    grid-area: eyebrow;
  }

  .visual-heading .heading-1 {
    grid-area: title;
    margin: 0;
  }

  .visual-heading .lead {
    grid-area: lead;
    margin: 0;
  }

  @media (max-width: 820px) {
    .visual-heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .visual-heading .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }
  }
</style>
