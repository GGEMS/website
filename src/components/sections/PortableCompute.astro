---
import type { Lang } from '../../i18n/config';
import { useCapabilityTranslations } from '../../i18n/capabilities';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useCapabilityTranslations(lang);

const systems = ['Windows', 'Linux', 'macOS'];
const vendors = ['Intel', 'AMD', 'NVIDIA'];
---

<section class="section portable-compute">
  <div class="container">
    <div class="portable-heading">
      <p class="eyebrow">{t('portable.eyebrow')}</p>
      <h2 class="heading-1">{t('portable.title')}</h2>
      <p class="lead">{t('portable.lead')}</p>
    </div>

    <div class="portable-map" aria-label={t('portable.title')}>
      <div class="portable-row portable-systems">
        <span class="row-label">{t('portable.os')}</span>

        <div class="node-grid">
          {systems.map((system) => <div class="platform-node">{system}</div>)}
        </div>
      </div>

      <div class="compute-bridge" aria-hidden="true">
        <span class="bridge-line"></span>

        <div class="opencl-core">
          <small>{t('portable.layer')}</small>
          <strong>OpenCL</strong>
        </div>

        <span class="bridge-line"></span>
      </div>

      <div class="portable-row portable-vendors">
        <span class="row-label">{t('portable.hardware')}</span>

        <div class="node-grid">
          {vendors.map((vendor) => <div class="platform-node vendor-node">{vendor}</div>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .portable-compute {
    position: relative;
    overflow: hidden;
  }

  .portable-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.35rem;
    align-items: start;
  }

  .portable-heading > .eyebrow {
    grid-area: eyebrow;
  }

  .portable-heading .heading-1 {
    grid-area: title;

    margin: 0;
  }

  .portable-heading .lead {
    grid-area: lead;

    margin: 0;
  }

  .portable-map {
    position: relative;

    margin-top: 4.5rem;
    padding: 2rem;

    overflow: hidden;

    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);

    background:
      radial-gradient(circle at 50% 50%, rgb(80 192 112 / 6%), transparent 22rem);
  }

  .portable-row {
    position: relative;
    z-index: 2;

    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
  }

  .row-label {
    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .node-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .platform-node {
    min-height: 5.3rem;

    display: grid;
    place-items: center;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    color: var(--color-text);

    background: rgb(127 127 127 / 2%);

    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .vendor-node {
    background: rgb(128 32 224 / 2.5%);
  }

  .compute-bridge {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;

    margin: 1.6rem 0 1.6rem 12rem;
  }

  .bridge-line {
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--color-green),
        transparent
      );
    opacity: 0.55;
  }

  .opencl-core {
    min-width: 12rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;

    padding: 1rem 1.6rem;

    border: 1px solid rgb(80 192 112 / 45%);
    border-radius: 999px;

    background: rgb(80 192 112 / 6%);

    box-shadow:
      0 0 0 0.35rem rgb(80 192 112 / 4%),
      0 0 2.4rem rgb(80 192 112 / 10%);
  }

  .opencl-core small {
    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .opencl-core strong {
    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .portable-heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .portable-heading .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }

    .portable-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .compute-bridge {
      margin-left: 0;
    }
  }

  @media (max-width: 620px) {
    .portable-map {
      padding: 1.5rem 1rem;
    }

    .node-grid {
      grid-template-columns: 1fr;
    }

    .platform-node {
      min-height: 4rem;
    }

    .compute-bridge {
      grid-template-columns: 1fr;
      justify-items: center;

      margin-block: 1.25rem;
    }

    .bridge-line {
      width: 1px;
      height: 2rem;

      background:
        linear-gradient(
          180deg,
          transparent,
          var(--color-green),
          transparent
        );
    }
  }
</style>
