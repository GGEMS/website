---
import type { Lang } from '../../i18n/config';
import { useCapabilityTranslations } from '../../i18n/capabilities';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useCapabilityTranslations(lang);

const systems = [
  { name: 'Windows', className: 'windows' },
  { name: 'Linux', className: 'linux' },
  { name: 'macOS', className: 'macos' },
];

const vendors = [
  { name: 'Intel', className: 'intel' },
  { name: 'AMD', className: 'amd' },
  { name: 'NVIDIA', className: 'nvidia' },
];
---

<section class="section portable-compute">
  <div class="container">
    <div class="portable-heading">
      <p class="eyebrow">{t('portable.eyebrow')}</p>
      <h2 class="heading-1">{t('portable.title')}</h2>
      <p class="lead">{t('portable.lead')}</p>
    </div>

    <div class="portable-map" aria-label={t('portable.title')}>
      <div class="portable-row portable-systems">
        <div class="node-grid">
          {systems.map((system) => (
            <div class={`platform-node ${system.className}`}>{system.name}</div>
          ))}
        </div>
      </div>

      <div class="compute-bridge" aria-hidden="true">
        <span class="bridge-line"></span>

        <div class="opencl-core">
          <small>{t('portable.layer')}</small>
          <strong>OpenCL</strong>
        </div>

        <span class="bridge-line"></span>
      </div>

      <div class="portable-row portable-vendors">
        <div class="node-grid">
          {vendors.map((vendor) => (
            <div class={`platform-node vendor-node ${vendor.className}`}>
              {vendor.name}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .portable-compute {
    position: relative;
    overflow: hidden;
  }

  .portable-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    grid-template-areas:
      'eyebrow .'
      'title lead';
    column-gap: 5rem;
    row-gap: 1.35rem;
    align-items: start;
  }

  .portable-heading > .eyebrow {
    grid-area: eyebrow;
  }

  .portable-heading .heading-1 {
    grid-area: title;

    margin: 0;
  }

  .portable-heading .lead {
    grid-area: lead;

    margin: 0;
  }

  .portable-map {
    position: relative;

    margin-top: 4.5rem;
    padding: 2rem;

    overflow: hidden;

    background:
      radial-gradient(circle at 50% 50%, rgb(80 192 112 / 6%), transparent 22rem);
  }

  .portable-row {
    position: relative;
    z-index: 2;

    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
  }

  .node-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .platform-node {
    --node-bg: rgb(127 127 127 / 2%);
    --node-border: var(--color-border);
    --node-glow: transparent;

    min-height: 5.3rem;

    display: grid;
    place-items: center;

    border: 1px solid var(--node-border);
    border-radius: var(--radius-md);

    color: var(--color-text);

    background: var(--node-bg);

    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 10%),
      0 0 1.8rem var(--node-glow);

    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Operating systems stay deliberately neutral: the visual message is that
     OpenCL spans all three rather than pairing an OS with a hardware vendor. */
  .portable-systems .platform-node {
    --node-bg:
      linear-gradient(
        145deg,
        rgb(126 138 148 / 9%),
        rgb(126 138 148 / 3%)
      );
    --node-border: rgb(126 138 148 / 20%);
    --node-glow: rgb(126 138 148 / 3%);
  }

  /* Hardware vendors keep restrained brand-associated tints without using
     third-party logos. */
  .intel {
    --node-bg: linear-gradient(145deg, rgb(0 113 197 / 14%), rgb(0 113 197 / 5%));
    --node-border: rgb(0 113 197 / 25%);
    --node-glow: rgb(0 113 197 / 5%);
  }

  .amd {
    --node-bg: linear-gradient(145deg, rgb(220 20 60 / 13%), rgb(220 20 60 / 4%));
    --node-border: rgb(220 20 60 / 23%);
    --node-glow: rgb(220 20 60 / 5%);
  }

  .nvidia {
    --node-bg: linear-gradient(145deg, rgb(118 185 0 / 15%), rgb(118 185 0 / 5%));
    --node-border: rgb(118 185 0 / 26%);
    --node-glow: rgb(118 185 0 / 6%);
  }

  :global([data-theme='dark']) .portable-systems .platform-node {
    --node-bg:
      linear-gradient(
        145deg,
        rgb(126 138 148 / 16%),
        rgb(126 138 148 / 6%)
      );
    --node-border: rgb(126 138 148 / 28%);
    --node-glow: rgb(126 138 148 / 5%);
  }

  :global([data-theme='dark']) .intel {
    --node-bg: linear-gradient(145deg, rgb(0 113 197 / 23%), rgb(0 113 197 / 8%));
    --node-border: rgb(0 113 197 / 35%);
    --node-glow: rgb(0 113 197 / 8%);
  }

  :global([data-theme='dark']) .amd {
    --node-bg: linear-gradient(145deg, rgb(220 20 60 / 22%), rgb(220 20 60 / 8%));
    --node-border: rgb(220 20 60 / 33%);
    --node-glow: rgb(220 20 60 / 8%);
  }

  :global([data-theme='dark']) .nvidia {
    --node-bg: linear-gradient(145deg, rgb(118 185 0 / 23%), rgb(118 185 0 / 8%));
    --node-border: rgb(118 185 0 / 35%);
    --node-glow: rgb(118 185 0 / 9%);
  }

  .compute-bridge {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;

    margin: 1.6rem 0;
  }

  .bridge-line {
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--color-green),
        transparent
      );
    opacity: 0.55;
  }

  .opencl-core {
    min-width: 12rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;

    padding: 1rem 1.6rem;

    border: 1px solid rgb(80 192 112 / 45%);
    border-radius: 999px;

    background: rgb(80 192 112 / 6%);

    box-shadow:
      0 0 0 0.35rem rgb(80 192 112 / 4%),
      0 0 2.4rem rgb(80 192 112 / 10%);
  }

  .opencl-core small {
    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .opencl-core strong {
    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .portable-heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'lead';
      gap: 1.35rem;
    }

    .portable-heading .lead {
      max-width: 44rem;
      margin-top: 1.1rem;
    }

    .portable-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .portable-map {
      padding: 1.5rem 1rem;
    }

    .node-grid {
      grid-template-columns: 1fr;
    }

    .platform-node {
      min-height: 4rem;
    }

    .compute-bridge {
      grid-template-columns: 1fr;
      justify-items: center;

      margin-block: 1.25rem;
    }

    .bridge-line {
      width: 1px;
      height: 2rem;

      background:
        linear-gradient(
          180deg,
          transparent,
          var(--color-green),
          transparent
        );
    }
  }
</style>
