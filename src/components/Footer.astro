---
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/images/ggems-logo.png" alt="" />

      <div class="footer-brand-copy">
        <strong>GGEMS</strong>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </div>

    <address class="footer-institution">
      <strong>LaTIM — INSERM UMR 1101</strong>
      <span>22 Avenue Camille Desmoulins · 29238 Brest Cedex 3 · France</span>
    </address>

    <div class="footer-balance" aria-hidden="true"></div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);

    background:
      linear-gradient(
        to bottom,
        var(--color-footer-sheen),
        transparent
      ),
      var(--color-bg);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;

    padding-block: 1.35rem;
  }

  .footer-brand {
    justify-self: start;

    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-brand img {
    width: 2.35rem;
    height: 2.35rem;

    object-fit: contain;
  }

  .footer-brand-copy {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .footer-brand strong {
    color: var(--color-text);

    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .footer-brand-copy span {
    color: var(--color-text-subtle);

    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .footer-institution {
    justify-self: center;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.16rem;

    margin: 0;

    color: var(--color-text-subtle);

    font-style: normal;
    text-align: center;
  }

  .footer-institution strong {
    color: var(--color-text-muted);

    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.025em;
  }

  .footer-institution span {
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .footer-balance {
    justify-self: end;
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.8rem;

      padding-block: 1.2rem;
    }

    .footer-brand,
    .footer-institution {
      justify-self: center;
    }

    .footer-balance {
      display: none;
    }
  }
</style>
