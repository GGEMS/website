---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import {
  defaultLang,
  localizedPath,
  supportedLanguages,
  type Lang,
} from '../i18n/config';

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
  lang?: Lang;
  localized?: boolean;
}

const props = Astro.props;

const title = props.title ?? 'GGEMS';
const description =
  props.description ??
  'GPU Geant4-based Monte Carlo Simulations for medical imaging, dosimetry and particle therapy.';
const noIndex = props.noIndex ?? false;
const lang = props.lang ?? defaultLang;
const localized = props.localized ?? !noIndex;

const origin = Astro.site ?? Astro.url.origin;
const currentPath = Astro.url.pathname;
const canonicalPath = localized
  ? localizedPath(currentPath, lang)
  : currentPath;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <script is:inline>
      (() => {
        let savedTheme = null;

        try {
          savedTheme = localStorage.getItem('ggems-theme');
        } catch {
          // Fall back to the operating-system preference.
        }

        const systemTheme = window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';

        document.documentElement.dataset.theme =
          savedTheme === 'light' || savedTheme === 'dark'
            ? savedTheme
            : systemTheme;
      })();
    </script>

    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    {noIndex && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <link rel="canonical" href={new URL(canonicalPath, origin)} />

    {
      localized &&
        supportedLanguages.map((locale) => (
          <link
            rel="alternate"
            hreflang={locale}
            href={new URL(localizedPath(currentPath, locale), origin)}
          />
        ))
    }

    {
      localized && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localizedPath(currentPath, defaultLang), origin)}
        />
      )
    }

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-256x256.png" />

    <title>{title}</title>
  </head>

  <body>
    <Header
      lang={lang}
      showLanguageSwitcher={localized}
    />

    <slot />

    <Footer lang={lang} />
  </body>
</html>
